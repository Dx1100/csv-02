---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = [
  { q: 'How do I merge multiple CSV files into one combined file?', a: 'Drop two or more CSV files into the dropzone above, arrange their order with the up/down arrows if desired, and click Merge CSV Files. The engine streams the files in your browser, unifies column headers, and downloads a single combined CSV.' },
  { q: 'What happens if my CSV files have different columns or headers in different orders?', a: 'Our engine computes the mathematical union of all column names across all files. It aligns matching column headers regardless of their position in the source files and populates blank cells for rows that lack specific columns, ensuring zero data misalignment.' },
  { q: 'Will the merged CSV contain duplicate header rows from each file?', a: 'No. The merger extracts and combines the header once at the very top of the output file. Individual headers from second, third, and subsequent files are cleanly stripped to produce a unified tabular schema.' },
  { q: 'How many CSV files can I combine at once?', a: 'There is no hardcoded file count limit. You can combine dozens of monthly reports or daily exports totaling hundreds of megabytes. Processing is streamed sequentially inside a background Web Worker so browser memory stays lean.' },
  { q: 'Can I reorder the files before merging?', a: 'Yes. Use the up and down arrow buttons next to each file in the queue to specify the exact sequence in which rows should be appended in the master document.' },
  { q: 'Are my confidential spreadsheets stored or uploaded during merging?', a: 'Never. Processing executes 100% locally on your machine via HTML5 stream readers and background Web Workers. Your data is never transmitted across the network, making it compliant with HIPAA, GDPR, and enterprise privacy mandates.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'CSV Merger', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Free online tool to merge multiple CSV files into one, handling mismatched columns automatically. Runs locally in the browser.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'CSV Merger', item: pageUrl },
  ] },
];
---

<Base
  title="Merge CSV Files Online Free — Combine Multiple CSVs Into One"
  description="Free online CSV merger. Combine multiple CSV files into one, even with different columns. No signup, no upload: files are merged privately in your browser."
  schema={schema}
>
  <div class="container">
    <h1>Merge CSV Files Online</h1>
    <p class="lead">
      <strong>How do you combine multiple CSV files?</strong> Select two or more spreadsheets below, arrange their merge sequence, and click Merge CSV Files. The tool merges your records into a unified dataset with a single standardized header row, automatically reconciling mismatched column structures. 100% free, private, and client-side.
    </p>

    <div class="tool">
      <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Choose CSV files or drag and drop them here">
        <p><strong>Drop CSV files here</strong> or click to browse (select multiple)</p>
        <p class="muted">Processed locally — never uploaded</p>
      </div>
      <input type="file" id="file-input" accept=".csv,text/csv" multiple />
      <ul class="file-list" id="file-list"></ul>
      <button class="btn" id="run" disabled>Merge CSV files</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
      <ul class="results" id="results"></ul>
    </div>

    <AdSlot format="horizontal" />

    <h2>How to Combine Multiple CSV Files (Step-by-Step Guide)</h2>
    <ol class="steps">
      <li><strong>Select Multiple Files:</strong> Drag and drop your collection of CSV files into the dropzone above, or click to open your OS file dialog and multi-select (using Shift or Ctrl/Cmd).</li>
      <li><strong>Arrange Sequence:</strong> Review the uploaded file queue. Click the up (&uarr;) or down (&darr;) buttons to adjust the order in which rows will be stacked. Use the remove button (&cross;) to prune unwanted files.</li>
      <li><strong>Execute Consolidation:</strong> Click <strong>Merge CSV files</strong>. The background worker ingests each file sequentially, extracts headers, constructs a master schema, and stitches records together.</li>
      <li><strong>Save Master Export:</strong> Once processing completes, click the download button to save your consolidated master CSV.</li>
    </ol>

    <h2>Why Manual Spreadsheet Merging Fails</h2>
    <p>
      Data analysts and operational teams frequently receive fragmented data: twelve monthly sales sheets, regional CRM extracts, or paginated log files. Consolidating them manually in traditional desktop spreadsheet tools leads to frequent disasters:
    </p>
    <ul>
      <li><strong>The Copy-Paste Column Shift Disaster:</strong> If File A has columns <code>[Name, Email, Phone]</code> and File B has <code>[Email, Name, Phone]</code>, manual copy-pasting silently dumps email addresses into the name column. CSV Toolbox automatically maps column headers by name, guaranteeing perfect alignment regardless of original column order.</li>
      <li><strong>Duplicate Header Pollution:</strong> Manually stacking 20 files in Excel leaves 19 residual header rows buried randomly throughout your dataset, which destroys downstream SQL imports, breaks numeric summaries, and corrupts pivot tables.</li>
      <li><strong>Clipboard Truncation &amp; Memory Leaks:</strong> Copying 300,000 rows between spreadsheet windows regularly exceeds OS clipboard limits, freezing your computer and triggering "Excel out of memory" errors.</li>
    </ul>

    <h2>Developer Automation: Command-Line &amp; Script Alternatives</h2>
    <p>
      For recurring data engineering pipelines, engineers automate CSV concatenation using scripting toolchains:
    </p>

    <h3>1. Python &amp; Pandas (Schema-Aware Concatenation)</h3>
    <pre><code>import glob
import pandas as pd

# Discover all regional export files
all_files = sorted(glob.glob("data_*.csv"))

# Read and concatenate with schema union
dataframes = [pd.read_csv(f) for f in all_files]
merged_df = pd.concat(dataframes, ignore_index=True)

# Export consolidated master file
merged_df.to_csv("master_consolidated.csv", index=False)
print(f"Merged &#123;len(all_files)&#125; files into &#123;len(merged_df)&#125; total rows.")</code></pre>

    <h3>2. GNU Bash (Ultra-Fast Identical Schema Merge)</h3>
    <pre><code># Merge hundreds of CSVs with identical columns in 1 second
head -n 1 file_01.csv &gt; combined.csv
tail -n +2 -q file_*.csv &gt;&gt; combined.csv</code></pre>

    <h2>Edge-Case Troubleshooting &amp; Schema Hygiene</h2>
    <p>
      Merging disparate CSV datasets frequently surfaces formatting inconsistencies:
    </p>
    <ul>
      <li><strong>Case-Sensitive Column Names:</strong> Headers like <code>Email</code>, <code>email</code>, and <code>EMAIL</code> are interpreted as distinct columns by database engines. Prior to merging, ensure naming conventions match, or clean them up using our <a href="/extract-columns-csv/">CSV Column Extractor</a>.</li>
      <li><strong>Different Delimiters Across Files:</strong> If one file uses commas and another uses semicolons, convert them to standard commas using our <a href="/change-delimiter-csv/">CSV Delimiter Converter</a> so rows align properly.</li>
      <li><strong>Removing Post-Merge Duplicates:</strong> When combining regional exports, duplicate customer records often overlap. Run your merged file through our <a href="/remove-duplicates-csv/">Duplicate Row Remover</a> to deduplicate by unique IDs or email addresses.</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <aside class="related">
      <strong>Related tools:</strong>
      <a href="/split-csv/">Split CSV files</a> ·
      <a href="/remove-duplicates-csv/">Remove duplicate rows</a> ·
      <a href="/extract-columns-csv/">Extract CSV columns</a> ·
      <a href="/csv-to-json/">Convert CSV to JSON</a> ·
      <a href="/guides/">All guides</a>
    </aside>
  </div>

  <script is:inline src="/js/tool-common.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var T = window.CSVTB, files = [];
      var worker = new Worker('/workers/csv-worker.js');
      var $ = function (id) { return document.getElementById(id); };
      var listEl = $('file-list'), runBtn = $('run'), status = $('status'), resultsEl = $('results');

      T.setupDropzone('dropzone', 'file-input', function (fs) {
        fs.forEach(function (f) { files.push(f); });
        render();
      });

      function iconBtn(label, title, fn) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'icon-btn';
        b.textContent = label;
        b.title = title;
        b.setAttribute('aria-label', title);
        b.addEventListener('click', fn);
        return b;
      }

      function render() {
        listEl.innerHTML = '';
        files.forEach(function (f, i) {
          var li = document.createElement('li');
          var name = document.createElement('span');
          name.className = 'grow';
          name.textContent = (i + 1) + '. ' + f.name + ' (' + T.formatBytes(f.size) + ')';
          li.appendChild(name);
          li.appendChild(iconBtn('\u2191', 'Move up', function () {
            if (i > 0) { files.splice(i - 1, 0, files.splice(i, 1)[0]); render(); }
          }));
          li.appendChild(iconBtn('\u2193', 'Move down', function () {
            if (i < files.length - 1) { files.splice(i + 1, 0, files.splice(i, 1)[0]); render(); }
          }));
          li.appendChild(iconBtn('\u2715', 'Remove', function () {
            files.splice(i, 1); render();
          }));
          listEl.appendChild(li);
        });
        runBtn.disabled = files.length < 2;
      }

      worker.onmessage = function (e) {
        var d = e.data;
        if (d.type === 'progress') {
          status.textContent = 'Merging… ' + d.rows.toLocaleString() + ' rows combined';
        } else if (d.type === 'file') {
          T.addResult(resultsEl, d);
        } else if (d.type === 'done') {
          status.textContent = 'Done — ' + d.rows.toLocaleString() + ' rows merged from ' + files.length + ' files.';
          runBtn.disabled = false;
        } else if (d.type === 'error') {
          status.textContent = 'Error: ' + d.message;
          runBtn.disabled = false;
        }
      };

      runBtn.addEventListener('click', function () {
        if (files.length < 2) return;
        resultsEl.innerHTML = '';
        runBtn.disabled = true;
        status.textContent = 'Merging…';
        worker.postMessage({ op: 'merge', files: files });
      });
    });
  </script>
</Base>
