---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = [
  { q: 'How do I convert a CSV file to JSON online?', a: 'Drop your CSV spreadsheet into the tool above and click Convert. Each row is instantly converted into a JSON object where column headers serve as object keys. The formatted, pretty-printed JSON array downloads immediately.' },
  { q: 'Can I convert a JSON file back into a standard CSV?', a: 'Yes. Switch the conversion direction toggle to "JSON → CSV" and upload a valid JSON file containing an array of objects. The tool extracts unique keys to build the header row and formats all child objects into standard comma-separated lines.' },
  { q: 'What specific JSON schema does the converter generate?', a: 'The tool outputs a clean, indented JSON array of objects ([{...}, {...}]), which is the standard format required by modern REST APIs, MongoDB, PostgreSQL JSONB columns, and frontend frameworks (React, Vue).' },
  { q: 'How does the converter handle missing or empty cells in rows?', a: 'Empty CSV cells are converted to empty string values ("") or omitted depending on schema, ensuring your output remains valid RFC 8259 JSON without syntax errors.' },
  { q: 'What is the maximum file size for CSV to JSON conversion?', a: 'Because parsing and string serialization execute via background streaming Web Workers, files containing tens of thousands of rows and tens of megabytes convert in seconds without locking your browser.' },
  { q: 'Is my data transmitted or stored on any external server?', a: 'No. The entire conversion process occurs 100% locally inside your web browser. No files, records, or API keys are ever transmitted over the network.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'CSV to JSON Converter', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Free online converter between CSV and JSON. Converts CSV rows to a JSON array of objects and back. Runs locally in the browser.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'CSV to JSON Converter', item: pageUrl },
  ] },
];
---

<Base
  title="Convert CSV to JSON Online Free (and JSON to CSV) — No Signup"
  description="Free online CSV to JSON converter, plus JSON to CSV. Each row becomes a JSON object keyed by headers. No signup, no upload: conversion runs privately in your browser."
  schema={schema}
>
  <div class="container">
    <h1>Convert CSV to JSON Online</h1>
    <p class="lead">
      <strong>How do you convert CSV to JSON?</strong> Drop your spreadsheet below and click Convert. Every row is transformed into a structured JSON object with column headers as keys. Need the reverse? Easily toggle JSON to CSV mode. 100% free, private, and client-side.
    </p>

    <div class="tool">
      <div class="direction-container">
        <div class="direction-info">
          <span class="direction-badge"><span class="direction-badge-dot"></span> Conversion Direction</span>
          <p class="direction-label">Select conversion mode:</p>
        </div>
        <div class="direction-btn-group" role="tablist" aria-label="Conversion Direction">
          <button type="button" class="direction-btn active" data-dir="c2j" role="tab" aria-selected="true">
            <span>CSV</span> <span class="arrow-icon">→</span> <span>JSON</span>
          </button>
          <button type="button" class="direction-btn" data-dir="j2c" role="tab" aria-selected="false">
            <span>JSON</span> <span class="arrow-icon">→</span> <span>CSV</span>
          </button>
        </div>
        <select id="direction" class="direction-select-sync" aria-label="Conversion direction">
          <option value="c2j" selected>CSV → JSON</option>
          <option value="j2c">JSON → CSV</option>
        </select>
      </div>
      <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Choose a file or drag and drop it here">
        <p><strong id="dz-label">Drop your CSV file here</strong> or click to browse</p>
        <p class="muted">Processed locally — never uploaded</p>
      </div>
      <input type="file" id="file-input" accept=".csv,text/csv" />
      <p class="status" id="file-name" hidden></p>
      <button class="btn" id="run" disabled>Convert</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
      <ul class="results" id="results"></ul>
    </div>

    <AdSlot format="horizontal" />

    <h2>How to Convert CSV to JSON (Step-by-Step Guide)</h2>
    <ol class="steps">
      <li><strong>Select Direction:</strong> Choose <strong>CSV → JSON</strong> (to transform spreadsheets into web payloads) or <strong>JSON → CSV</strong> (to flatten nested API responses into spreadsheet tables).</li>
      <li><strong>Select Your Source File:</strong> Drag and drop your file into the dropzone above, or click to browse. The file name and size will be verified immediately.</li>
      <li><strong>Execute Serialization:</strong> Click <strong>Convert</strong>. The background Web Worker tokenizes your rows, pairs column headers with cell values, and formats the JSON data structures.</li>
      <li><strong>Download Formatted Payload:</strong> Click the generated download button to save your formatted <code>.json</code> file.</li>
    </ol>

    <h2>Why Spreadsheet Software Struggles with JSON Workflows</h2>
    <p>
      Spreadsheet software like Microsoft Excel and Google Sheets is designed around flat two-dimensional visual grids. Modern web engineering, however, relies on hierarchical, key-value JSON trees:
    </p>
    <ul>
      <li><strong>No Native JSON Export in Excel:</strong> Microsoft Excel does not provide a direct "Save As JSON" option. Software engineers are forced to write custom VBA macros, use complex Power Query transformations, or resort to copy-pasting into unverified web converters.</li>
      <li><strong>Silent Type Coercion of Numerical Strings:</strong> When exporting data via spreadsheets, numeric strings like product SKU codes (<code>004598</code>) or phone numbers are stripped of leading zeros, outputting invalid JSON integers instead of string identifiers.</li>
      <li><strong>Unescaped Special Characters:</strong> Delimited text often contains double quotes, backward slashes, and control characters. Manually converting CSV to JSON without escaping leads to broken JSON syntax errors (<code>Unexpected token in JSON at position...</code>).</li>
    </ul>

    <h2>Developer Automation: Command-Line &amp; Script Alternatives</h2>
    <p>
      Developers frequently script CSV-to-JSON transformations using Python and Node.js:
    </p>

    <h3>1. Python &amp; Pandas (Instant Array of Objects)</h3>
    <pre><code>import pandas as pd

# Ingest CSV and serialize directly to JSON records
df = pd.read_csv("catalog_data.csv")
df.to_json("catalog_output.json", orient="records", indent=2)
print("Successfully converted CSV to formatted JSON.")</code></pre>

    <h3>2. Node.js (Streaming Converter)</h3>
    <pre><code>const fs = require('fs');
const readline = require('readline');

const rl = readline.createInterface(&#123;
  input: fs.createReadStream('input.csv'),
  crlfDelay: Infinity
&#125;);

let headers = [];
const records = [];

rl.on('line', (line) =&gt; &#123;
  const values = line.split(',');
  if (!headers.length) &#123;
    headers = values;
  &#125; else &#123;
    const obj = &#123;&#125;;
    headers.forEach((h, i) =&gt; obj[h.trim()] = values[i]?.trim());
    records.push(obj);
  &#125;
&#125;);

rl.on('close', () =&gt; &#123;
  fs.writeFileSync('output.json', JSON.stringify(records, null, 2));
&#125;);</code></pre>

    <h2>Edge-Case Troubleshooting &amp; Formatting Tips</h2>
    <p>
      Keep these critical formatting details in mind when converting between tabular and object formats:
    </p>
    <ul>
      <li><strong>Header Uniqueness:</strong> Ensure every CSV column has a distinct header name. Duplicate headers cause JSON object keys to overwrite earlier values.</li>
      <li><strong>Nested JSON Structures:</strong> If your JSON file contains deeply nested sub-objects or arrays, flattening to CSV will serialize nested structures as stringified JSON strings.</li>
      <li><strong>YAML Alternative:</strong> If you are building Kubernetes or DevOps configurations rather than web APIs, try our <a href="/csv-to-yaml/">CSV to YAML Converter</a>.</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <aside class="related">
      <strong>Related tools:</strong>
      <a href="/csv-to-yaml/">Convert CSV to YAML</a> ·
      <a href="/csv-to-xml/">Convert CSV to XML</a> ·
      <a href="/csv-to-markdown/">Convert CSV to Markdown</a> ·
      <a href="/split-csv/">Split CSV files</a> ·
      <a href="/guides/">All guides</a>
    </aside>
  </div>

  <script is:inline src="/js/tool-common.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var T = window.CSVTB, file = null;
      var worker = new Worker('/workers/csv-worker.js');
      var $ = function (id) { return document.getElementById(id); };
      var dirSel = $('direction'), runBtn = $('run'), status = $('status'), resultsEl = $('results');
      T.setupDirectionButtons('direction');

      dirSel.addEventListener('change', function () {
        var c2j = dirSel.value === 'c2j';
        $('dz-label').textContent = c2j ? 'Drop your CSV file here' : 'Drop your JSON file here';
        $('file-input').accept = c2j ? '.csv,text/csv' : '.json,application/json';
        file = null;
        $('file-name').hidden = true;
        runBtn.disabled = true;
      });

      T.setupDropzone('dropzone', 'file-input', function (files) {
        file = files[0];
        $('file-name').textContent = 'Selected: ' + file.name + ' (' + T.formatBytes(file.size) + ')';
        $('file-name').hidden = false;
        runBtn.disabled = false;
      });

      worker.onmessage = function (e) {
        var d = e.data;
        if (d.type === 'progress') {
          status.textContent = 'Converting… ' + d.rows.toLocaleString() + ' rows';
        } else if (d.type === 'file') {
          T.addResult(resultsEl, d);
        } else if (d.type === 'done') {
          status.textContent = 'Done — ' + d.rows.toLocaleString() + ' records converted.';
          runBtn.disabled = false;
        } else if (d.type === 'error') {
          status.textContent = 'Error: ' + d.message;
          runBtn.disabled = false;
        }
      };

      runBtn.addEventListener('click', function () {
        if (!file) return;
        resultsEl.innerHTML = '';
        runBtn.disabled = true;
        status.textContent = 'Converting…';
        worker.postMessage({ op: dirSel.value === 'c2j' ? 'csv-to-json' : 'json-to-csv', file: file });
      });
    });
  </script>
</Base>
