---
import Base from '../layouts/Base.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Terms of Use — CSV Toolbox',
    url: pageUrl,
    description: 'Terms of use for CSV Toolbox: acceptable use, no-warranty disclaimers, and local client-side processing terms.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Terms of Use', item: pageUrl }
    ]
  }
];
---

<Base
  title="Terms of Use — CSV Toolbox"
  description="Terms of use for CSV Toolbox, a suite of free browser-based CSV tools."
  schema={schema}
>
  <div class="container guide">
    <h1>Terms of Use</h1>
    <p class="muted">Last updated: November 2026</p>
    <p>
      By using CSV Toolbox you agree to these terms. The short version: the tools are free, your
      files stay on your device, and the service is provided as-is.
    </p>

    <h2>Use of the service</h2>
    <p>
      You may use the tools for any lawful purpose, personal or commercial, free of charge. You may
      not attempt to disrupt the service or misuse the site in ways that harm other users.
    </p>

    <h2>No warranty</h2>
    <p>
      The service is provided <strong>"as is" without warranties of any kind</strong>. While the
      tools are carefully built and tested, we cannot guarantee they are error-free for every
      possible file. Always keep your original files; verify important outputs before relying on
      them.
    </p>

    <h2>Limitation of liability</h2>
    <p>
      To the maximum extent permitted by law, CSV Toolbox shall not be liable for any damages
      arising from the use or inability to use the service, including data loss. Because processing
      happens on your device, you remain in control of your data at all times.
    </p>

    <h2>Changes</h2>
    <p>
      We may update these terms or modify the service at any time. Continued use after changes
      constitutes acceptance. Questions? <a href="/contact/">Contact us</a>.
    </p>
  </div>
</Base>
