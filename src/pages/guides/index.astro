---
import Base from '../../layouts/Base.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const guides = [
  { href: '/guides/how-to-open-a-large-csv-file-without-crashing/', title: 'How to Open a 500MB+ CSV File Without Crashing Excel', desc: 'Inspect, search, and page through massive gigabyte-scale datasets with zero browser lag or memory crashes.' },
  { href: '/guides/excel-cannot-open-more-than-1048576-rows-fix/', title: 'Excel Cannot Open More Than 1,048,576 Rows: 3 Fixes', desc: 'Why Excel truncates rows at 1,048,576, and how to safely split or inspect files to prevent data loss.' },
  { href: '/guides/how-to-split-a-large-csv-file-without-excel/', title: 'How to Split a Large CSV File Without Excel', desc: 'Excel chokes past 1,048,576 rows. Here is how to split any large CSV in seconds, free and offline.' },
  { href: '/guides/how-to-change-csv-delimiter-semicolon-to-comma/', title: 'How to Change CSV Delimiter (Semicolon to Comma or Tab)', desc: 'Fix regional European Excel exports, convert delimiters safely, and preserve UTF-8 accent characters.' },
  { href: '/guides/split-csv-by-column-value/', title: 'How to Split a CSV by Column Value', desc: 'Create one file per country, category or customer automatically from a single CSV.' },
  { href: '/guides/merge-multiple-csv-files-into-one/', title: 'How to Merge Multiple CSV Files Into One', desc: 'Combine many CSV exports into a single clean file, even when columns differ.' },
  { href: '/guides/remove-duplicate-rows-from-csv/', title: 'How to Remove Duplicate Rows From a CSV', desc: 'Clean duplicate contacts, orders or records from a CSV, by whole row or specific columns.' },
  { href: '/guides/convert-csv-to-json/', title: 'How to Convert CSV to JSON (and Back)', desc: 'Turn spreadsheet exports into API-ready JSON in one click, no coding required.' },
  { href: '/guides/convert-csv-to-markdown-table/', title: 'How to Convert CSV to Markdown Table for GitHub & Docs', desc: 'Generate aligned GitHub-flavored Markdown tables from spreadsheet data with instant copy and download.' },
  { href: '/guides/convert-csv-to-xml-online/', title: 'How to Convert CSV to XML (and XML to CSV) Free Online', desc: 'Transform flat tabular records into structured XML nodes for ERPs, feeds, and configurations.' },
  { href: '/guides/convert-bank-statement-pdf-to-csv-safely/', title: 'How to Convert Bank Statement PDF to CSV Safely (No Server Uploads)', desc: 'Extract clean transaction tables from locked PDF statements without risking confidential financial data.' },
  { href: '/guides/fix-excel-pdf-copy-paste-single-column-problem/', title: 'Why PDF Tables Paste into a Single Excel Column (And 4 Fixes)', desc: 'Understand why clipboard collapse happens when copying tables from PDF to Excel, and how to fix it in seconds.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'CSV Guides & Tutorials — CSV Toolbox',
    url: pageUrl,
    description: 'Comprehensive tutorials on handling large CSV files, resolving Excel spreadsheet limits, changing delimiters, and converting data formats.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: pageUrl }
    ]
  }
];
---

<Base
  title="CSV Guides & Tutorials — CSV Toolbox"
  description="Practical guides for working with CSV files: splitting large files, merging exports, removing duplicates and converting to JSON, XML & Markdown."
  schema={schema}
>
  <div class="container">
    <h1>CSV Guides &amp; Tutorials</h1>
    <p class="lead">Practical, step-by-step answers to the most common CSV problems. Every guide pairs with a free tool that runs privately in your browser.</p>
    <div class="cards">
      {guides.map((g) => (
        <a class="card" href={g.href}>
          <h3>{g.title}</h3>
          <p>{g.desc}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
