---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = [
  { q: 'How do I convert a CSV file to XML?', a: 'Upload your CSV file into the converter box above. The tool automatically detects your column headers and converts each row into a structured XML row. The conversion is fully local, so it processes immediately in your browser.' },
  { q: 'What XML structure is generated by this converter?', a: 'It wraps the output in a root <root> tag, and represents each row as a <row> element. Individual cell values are enclosed in tags named after the corresponding column headers (with spaces and invalid characters replaced by underscores).' },
  { q: 'Is my CSV data uploaded to a server?', a: 'No, never. The file conversion runs locally using your web browser\'s processing power. Your files remain safe and private on your device.' },
  { q: 'Can I convert large CSV files to XML?', a: 'Yes. Thanks to Web Workers streaming technology, our tools can process larger CSV files without freezing your browser. The output file will download automatically once ready.' }
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'CSV to XML Converter', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Free online CSV to XML converter. Convert comma separated values to structured XML tags locally in the browser with no upload.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'CSV to XML Converter', item: pageUrl },
  ] },
];
---

<Base
  title="Convert CSV to XML Online Free — Local Separator to Tag Converter"
  description="Convert CSV files to XML formatted documents online for free. Clean nested tag output, automatic header detection. No registration, 100% private in-browser conversion."
  schema={schema}
>
  <div class="container">
    <h1>Convert CSV to XML Online</h1>
    <p class="lead">
      <strong>Looking to convert comma-separated files or Excel exports into XML format?</strong> Drop your CSV 
      document below and click Convert. Each column header becomes an XML element, and each row is turned into a 
      clean nested structure. Safe, free, and runs entirely in your browser without any server uploads.
    </p>

    <div class="tool">
      <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Choose a CSV file or drag and drop it here">
        <p><strong>Drop your CSV file here</strong> or click to browse</p>
        <p class="muted">Processed locally — never uploaded</p>
      </div>
      <input type="file" id="file-input" accept=".csv,text/csv,.tsv,.txt" />
      <p class="status" id="file-name" hidden></p>
      <div class="preview-wrap" id="preview" hidden></div>
      <button class="btn" id="run" disabled>Convert to XML</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
      <ul class="results" id="results"></ul>
    </div>

    <AdSlot />

    <h2>How to convert CSV to XML tags</h2>
    <ol class="steps">
      <li><strong>Upload your CSV file.</strong> Drag your file into the dashed box or select it from your device. You'll see a preview of the columns instantly.</li>
      <li><strong>Generate XML.</strong> Click the "Convert to XML" button to start the process inside a Web Worker.</li>
      <li><strong>Download your XML file.</strong> Save the resulting `.xml` document directly. Column names become custom XML elements automatically.</li>
    </ol>

    <h2>Why use our local CSV to XML Converter?</h2>
    <ul>
      <li><strong>Zero Server Uploads:</strong> Ideal for sensitive client records, financials, and private business data.</li>
      <li><strong>Standard Tag Formats:</strong> Escapes special characters (`&amp;`, `&lt;`, `&gt;`) so the final XML is fully compliant and well-formed.</li>
    </ul>

    <h2>Frequently asked questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <aside class="related">
      <strong>Related tools:</strong>
      <a href="/split-csv/">Split CSV files</a> ·
      <a href="/merge-csv/">Merge CSV files</a> ·
      <a href="/csv-to-json/">Convert CSV to JSON</a> ·
      <a href="/csv-to-yaml/">Convert CSV to YAML</a>
    </aside>
  </div>

  <script is:inline src="/js/tool-common.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var T = window.CSVTB, file = null;
      var worker = new Worker('/workers/csv-worker.js');
      var $ = function (id) { return document.getElementById(id); };
      var runBtn = $('run'), status = $('status'), resultsEl = $('results');

      T.setupDropzone('dropzone', 'file-input', function (files) {
        file = files[0];
        $('file-name').textContent = 'Selected: ' + file.name + ' (' + T.formatBytes(file.size) + ')';
        $('file-name').hidden = false;
        runBtn.disabled = false;
        T.previewCSV(file, $('preview'), 6);
      });

      worker.onmessage = function (e) {
        var d = e.data;
        if (d.type === 'progress') {
          status.textContent = 'Converting… ' + d.rows.toLocaleString() + ' rows read';
        } else if (d.type === 'file') {
          T.addResult(resultsEl, d);
        } else if (d.type === 'done') {
          status.textContent = 'Done — successfully converted ' + d.rows.toLocaleString() + ' rows to XML.';
          runBtn.disabled = false;
        } else if (d.type === 'error') {
          status.textContent = 'Error: ' + d.message;
          runBtn.disabled = false;
        }
      };

      runBtn.addEventListener('click', function () {
        if (!file) return;
        resultsEl.innerHTML = '';
        runBtn.disabled = true;
        status.textContent = 'Converting…';
        worker.postMessage({ op: 'csv-to-xml', file: file });
      });
    });
  </script>
</Base>
