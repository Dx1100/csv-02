---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = [
  { q: 'How do I convert a CSV file to XML?', a: 'Select "CSV → XML" above, upload your CSV file, and click Convert. The tool maps column headers to XML elements and converts each row into a structured <row> tag inside a <root> container. The conversion runs immediately and locally in your browser.' },
  { q: 'How do I convert an XML file back into a CSV file?', a: 'Select "XML → CSV", upload or drop your XML document (.xml or .txt), and click Convert. The tool automatically detects repeating record elements, extracts child tags and attributes as columns, and downloads a clean CSV spreadsheet.' },
  { q: 'What XML structure is generated from CSV data?', a: 'It produces a standard XML document enclosed in a <root> element, containing individual <row> records. Field names are sanitized to valid XML tag names (spaces and special characters replaced with underscores), and cell values are properly entity-escaped.' },
  { q: 'What XML structures can be converted to CSV?', a: 'The parser supports standard element-based records (such as <users><user><name>...</name></user></users>), attribute-based records (<records><row id="1" name="Alice" /></records>), and mixed datasets. It aggregates all unique tags across records so missing tags become empty CSV cells without shifting columns.' },
  { q: 'How are special characters (&, <, >, ", \') handled?', a: 'When converting CSV to XML, special characters are automatically escaped to standard XML entities (&amp;, &lt;, &gt;, &quot;, &apos;). When converting XML to CSV, entities are decoded back into plain readable text.' },
  { q: 'Is my data or file uploaded to any external server?', a: 'No, never. All parsing, DOM traversal, and file generation happens entirely client-side in your web browser. No files, records, or credentials leave your computer.' }
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'CSV ⇄ XML Converter', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Free online CSV to XML and XML to CSV converter. Convert tabular data into XML tags and XML files back into CSV spreadsheets locally in browser.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'CSV ⇄ XML Converter', item: pageUrl },
  ] },
];
---

<Base
  title="CSV ⇄ XML Converter Online Free — Both Directions"
  description="Convert CSV files to structured XML documents, or convert XML documents back to CSV spreadsheets. Automatic tag detection, clean attributes, 100% private in-browser conversion."
  schema={schema}
>
  <div class="container">
    <h1>CSV ⇄ XML Converter Online</h1>
    <p class="lead">
      <strong>Need to convert between CSV spreadsheets and XML documents?</strong> 
      Transform CSV records into clean, well-formed XML tag structures, or parse XML data feeds back into tabular CSV spreadsheets. 
      Runs 100% locally in your web browser with zero server uploads for total privacy.
    </p>

    <div class="tool">
      <div class="direction-container">
        <div class="direction-info">
          <span class="direction-badge"><span class="direction-badge-dot"></span> Conversion Direction</span>
          <p class="direction-label">Select conversion mode:</p>
        </div>
        <div class="direction-btn-group" role="tablist" aria-label="Conversion Direction">
          <button type="button" class="direction-btn active" data-dir="c2x" role="tab" aria-selected="true">
            <span>CSV</span> <span class="arrow-icon">→</span> <span>XML</span>
          </button>
          <button type="button" class="direction-btn" data-dir="x2c" role="tab" aria-selected="false">
            <span>XML</span> <span class="arrow-icon">→</span> <span>CSV</span>
          </button>
        </div>
        <select id="direction" class="direction-select-sync" aria-label="Conversion direction">
          <option value="c2x" selected>CSV → XML</option>
          <option value="x2c">XML → CSV</option>
        </select>
      </div>

      <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Choose a file or drag and drop it here">
        <p><strong id="dz-label">Drop your CSV file here</strong> or click to browse</p>
        <p class="muted">Processed locally — never uploaded</p>
      </div>
      <input type="file" id="file-input" accept=".csv,text/csv,.tsv,.txt" />
      <p class="status" id="file-name" hidden></p>
      <div class="preview-wrap" id="preview" hidden></div>
      
      <button class="btn" id="run" disabled>Convert</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
      <ul class="results" id="results"></ul>
    </div>

    <AdSlot />

    <h2>How the conversion works</h2>
    
    <h3>Direction 1: Converting CSV to XML</h3>
    <ol class="steps">
      <li><strong>Select "CSV → XML":</strong> Choose this option from the direction bar above.</li>
      <li><strong>Upload your CSV file:</strong> Drag and drop your <code>.csv</code> or <code>.tsv</code> file into the box to view a column preview.</li>
      <li><strong>Generate XML structure:</strong> Click Convert. Column headers are converted into custom XML element tags, rows are enclosed in <code>&lt;row&gt;</code> elements inside a <code>&lt;root&gt;</code> container, and special characters are entity-escaped.</li>
      <li><strong>Download your XML file:</strong> Save the resulting <code>.xml</code> document directly to your computer.</li>
    </ol>

    <h3>Direction 2: Converting XML to CSV</h3>
    <ol class="steps">
      <li><strong>Select "XML → CSV":</strong> Switch the direction toggle to enable XML extraction.</li>
      <li><strong>Upload your XML file:</strong> Drop your <code>.xml</code> or <code>.txt</code> file containing structured data records.</li>
      <li><strong>Extract spreadsheet columns:</strong> Click Convert. The tool parses the XML hierarchy, detects repeating record nodes, collects all unique child tags and attributes as column headers, and unparses values into CSV.</li>
      <li><strong>Download your CSV:</strong> Save the extracted file as a clean <code>.csv</code> spreadsheet for Microsoft Excel, Google Sheets, or database imports.</li>
    </ol>

    <h2>Why use our local CSV ⇄ XML Converter?</h2>
    <ul>
      <li><strong>True Bidirectional Utility:</strong> Easily switch back and forth between tabular spreadsheets and hierarchical XML feeds in one tool.</li>
      <li><strong>Smart Schema Detection:</strong> Automatically scans all XML records to discover attributes and child tags, ensuring no fields are dropped or shifted.</li>
      <li><strong>Compliant Entity Handling:</strong> Automatically escapes and decodes reserved XML characters (<code>&amp;</code>, <code>&lt;</code>, <code>&gt;</code>, quotes) so documents stay well-formed.</li>
      <li><strong>100% Private &amp; Local:</strong> No files or records are sent across the web. Ideal for sensitive client records, financials, and private business data.</li>
    </ul>

    <h2>Frequently asked questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <aside class="related">
      <strong>Related tools:</strong>
      <a href="/split-csv/">Split CSV files</a> ·
      <a href="/merge-csv/">Merge CSV files</a> ·
      <a href="/csv-to-json/">CSV ⇄ JSON</a> ·
      <a href="/csv-to-yaml/">CSV ⇄ YAML</a> ·
      <a href="/csv-to-markdown/">CSV ⇄ Markdown</a> ·
      <a href="/csv-to-html/">CSV ⇄ HTML</a>
    </aside>
  </div>

  <script is:inline src="/js/tool-common.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var T = window.CSVTB, file = null;
      var worker = new Worker('/workers/csv-worker.js');
      var $ = function (id) { return document.getElementById(id); };
      var dirSel = $('direction'), runBtn = $('run'), status = $('status'), resultsEl = $('results');
      T.setupDirectionButtons('direction');

      dirSel.addEventListener('change', function () {
        var c2x = dirSel.value === 'c2x';
        $('dz-label').textContent = c2x ? 'Drop your CSV file here' : 'Drop your XML (.xml, .txt) file here';
        $('file-input').accept = c2x ? '.csv,text/csv,.tsv,.txt' : '.xml,text/xml,.txt';
        file = null;
        $('file-name').hidden = true;
        $('preview').hidden = true;
        runBtn.disabled = true;
        resultsEl.innerHTML = '';
        status.textContent = '';
      });

      T.setupDropzone('dropzone', 'file-input', function (files) {
        file = files[0];
        $('file-name').textContent = 'Selected: ' + file.name + ' (' + T.formatBytes(file.size) + ')';
        $('file-name').hidden = false;
        runBtn.disabled = false;
        if (dirSel.value === 'c2x') {
          T.previewCSV(file, $('preview'), 6);
        } else {
          T.previewText(file, $('preview'), 8);
        }
      });

      worker.onmessage = function (e) {
        var d = e.data;
        if (d.type === 'progress') {
          status.textContent = 'Converting… ' + d.rows.toLocaleString() + ' rows read';
        } else if (d.type === 'file') {
          T.addResult(resultsEl, d);
        } else if (d.type === 'done') {
          var targetFmt = dirSel.value === 'c2x' ? 'XML' : 'CSV';
          status.textContent = 'Done — successfully converted ' + d.rows.toLocaleString() + ' records to ' + targetFmt + '.';
          runBtn.disabled = false;
        } else if (d.type === 'error') {
          status.textContent = 'Error: ' + d.message;
          runBtn.disabled = false;
        }
      };

      function parseXmlToRows(xmlString) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(xmlString, 'text/xml');
        var err = doc.querySelector('parsererror');
        if (err) {
          throw new Error('Malformed XML: ' + err.textContent.slice(0, 100));
        }
        var root = doc.documentElement;
        if (!root) throw new Error('Empty XML document.');

        var children = Array.prototype.slice.call(root.children);
        if (!children.length) {
          throw new Error('XML root element has no child records.');
        }

        // Drill down if root wraps a single container element e.g. <catalog><items><item>
        if (children.length === 1 && children[0].children.length > 1) {
          children = Array.prototype.slice.call(children[0].children);
        }

        var tagCounts = {};
        children.forEach(function (el) {
          tagCounts[el.tagName] = (tagCounts[el.tagName] || 0) + 1;
        });

        var primaryTag = null, maxCount = 0;
        for (var t in tagCounts) {
          if (tagCounts[t] > maxCount) {
            maxCount = tagCounts[t];
            primaryTag = t;
          }
        }

        var records = children;
        if (primaryTag && maxCount > 1) {
          records = children.filter(function (el) { return el.tagName === primaryTag; });
        }

        var headers = [];
        var headerSet = Object.create(null);

        records.forEach(function (rec) {
          if (rec.attributes) {
            for (var a = 0; a < rec.attributes.length; a++) {
              var attrName = rec.attributes[a].name;
              if (!headerSet[attrName]) {
                headerSet[attrName] = true;
                headers.push(attrName);
              }
            }
          }
          var childNodes = rec.children;
          if (childNodes && childNodes.length > 0) {
            for (var c = 0; c < childNodes.length; c++) {
              var nodeName = childNodes[c].tagName;
              if (!headerSet[nodeName]) {
                headerSet[nodeName] = true;
                headers.push(nodeName);
              }
            }
          } else if (rec.textContent && rec.textContent.trim()) {
            var valTag = rec.tagName || 'value';
            if (!headerSet[valTag]) {
              headerSet[valTag] = true;
              headers.push(valTag);
            }
          }
        });

        if (!headers.length) {
          throw new Error('No record fields found in the XML document.');
        }

        var rows = [headers];
        records.forEach(function (rec) {
          var row = [];
          var attrMap = {};
          if (rec.attributes) {
            for (var a = 0; a < rec.attributes.length; a++) {
              attrMap[rec.attributes[a].name] = rec.attributes[a].value;
            }
          }
          var childMap = {};
          var childNodes = rec.children;
          for (var c = 0; c < childNodes.length; c++) {
            childMap[childNodes[c].tagName] = childNodes[c].textContent.trim();
          }

          headers.forEach(function (h) {
            if (attrMap[h] !== undefined) {
              row.push(attrMap[h]);
            } else if (childMap[h] !== undefined) {
              row.push(childMap[h]);
            } else if (rec.children.length === 0 && h === rec.tagName) {
              row.push(rec.textContent.trim());
            } else {
              row.push('');
            }
          });
          rows.push(row);
        });

        return rows;
      }

      runBtn.addEventListener('click', function () {
        if (!file) return;
        resultsEl.innerHTML = '';
        runBtn.disabled = true;
        status.textContent = 'Converting…';

        if (dirSel.value === 'c2x') {
          worker.postMessage({ op: 'csv-to-xml', file: file });
        } else {
          file.text().then(function (xmlStr) {
            try {
              var parsedRows = parseXmlToRows(xmlStr);
              worker.postMessage({ op: 'xml-to-csv', file: file, content: parsedRows });
            } catch (err) {
              // Pass to worker fallback parser
              worker.postMessage({ op: 'xml-to-csv', file: file });
            }
          }).catch(function (err) {
            status.textContent = 'Error reading file: ' + err.message;
            runBtn.disabled = false;
          });
        }
      });
    });
  </script>
</Base>
