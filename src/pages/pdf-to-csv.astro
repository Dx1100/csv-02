---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = [
  { q: 'How do I convert a PDF table to CSV online?', a: 'Upload your PDF document into the dropzone above and click Extract Tables. The tool inspects text coordinates across all pages, groups text items into rows and columns, and generates a structured CSV spreadsheet ready for instant download.' },
  { q: 'Can I extract tables from multi-page PDFs?', a: 'Yes. The client-side parser loops through all pages of your PDF document sequentially, detecting header rows and aggregating all continuous data rows into a single unified CSV file.' },
  { q: 'Is it safe to upload sensitive bank statements or invoices?', a: 'Yes, 100%. Unlike cloud converters that upload your financial files to unknown remote servers, Free CSV Toolbox parses your PDF entirely inside your local browser memory using JavaScript and Web Workers. Your sensitive financial data never leaves your computer.' },
  { q: 'Why do copied tables from PDF paste into a single Excel column?', a: 'PDFs do not store tabular structures; they store individual text snippets positioned with visual X and Y canvas coordinates. When you copy-paste, Excel cannot detect column boundaries and collapses the text into column A. Our tool reconstructs the spatial grid by calculating horizontal gaps between words.' },
  { q: 'Does this tool work on scanned document photos or image receipts?', a: 'This tool is optimized for native digital PDFs (such as statements generated by banks, accounting software, Stripe, or QuickBooks). Scanned paper documents containing flattened raster images require Optical Character Recognition (OCR), which is not supported in this lightweight version.' },
  { q: 'Can I convert CSV spreadsheets back into PDF documents?', a: 'Yes. Switch the direction toggle to "CSV → PDF" or visit our dedicated CSV to PDF Converter to transform any spreadsheet into a cleanly paginated, printable PDF table.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'PDF to CSV Converter', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Free online PDF to CSV table extractor. Convert digital PDF statements, invoices, and reports to CSV spreadsheets privately in your browser.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'PDF to CSV Converter', item: pageUrl },
  ] },
];
---

<Base
  title="Convert PDF to CSV Online Free (and CSV to PDF) — 100% Private, No Upload"
  description="Extract tables from PDF to CSV online free. Runs 100% privately in your browser using client-side table detection. Safe for bank statements and invoices."
  schema={schema}
>
  <div class="container">
    <h1>Convert PDF to CSV Online</h1>
    <p class="lead">
      <strong>How do you extract tables from a PDF to CSV?</strong> Drop your digital PDF document below and click Extract Tables. Our spatial coordinate engine reconstructs rows and columns directly in your browser. 100% free, private, and zero server uploads — safe for sensitive bank statements and invoices.
    </p>

    <div class="tool">
      <div class="direction-container">
        <div class="direction-info">
          <span class="direction-badge"><span class="direction-badge-dot"></span> Conversion Direction</span>
          <p class="direction-label">Select conversion mode:</p>
        </div>
        <div class="direction-btn-group" role="tablist" aria-label="Conversion Direction">
          <button type="button" class="direction-btn active" data-dir="p2c" role="tab" aria-selected="true">
            <span>PDF</span> <span class="arrow-icon">→</span> <span>CSV</span>
          </button>
          <button type="button" class="direction-btn" data-dir="c2p" role="tab" aria-selected="false">
            <span>CSV</span> <span class="arrow-icon">→</span> <span>PDF</span>
          </button>
        </div>
        <select id="direction" class="direction-select-sync" aria-label="Conversion direction">
          <option value="p2c" selected>PDF → CSV</option>
          <option value="c2p">CSV → PDF</option>
        </select>
      </div>

      <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Choose a file or drag and drop it here">
        <p><strong id="dz-label">Drop your PDF document here</strong> or click to browse</p>
        <p class="muted">Processed locally — zero server uploads, safe for financial data</p>
      </div>
      <input type="file" id="file-input" accept=".pdf,application/pdf" />
      <p class="status" id="file-name" hidden></p>

      <div id="pdf-options" style="margin: 1.25rem 0; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: center;">
        <label style="font-size: 0.9rem; font-weight: 500; color: var(--ink);">
          Column Gap Sensitivity:
          <select id="gap-tolerance" style="margin-left: 0.5rem; padding: 0.35rem 0.65rem; border: 1px solid var(--border); border-radius: 6px; background: #fff;">
            <option value="12">Standard (Balanced)</option>
            <option value="8">Tight (Compact Tables)</option>
            <option value="18">Wide (Sparse Columns)</option>
          </select>
        </label>
      </div>

      <button class="btn" id="run" disabled>Extract Tables to CSV</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
      <ul class="results" id="results"></ul>
    </div>

    <AdSlot format="horizontal" />

    <h2>How to Convert PDF Tables to CSV (Step-by-Step Guide)</h2>
    <ol class="steps">
      <li><strong>Select Direction:</strong> Choose <strong>PDF → CSV</strong> to parse tabular statements into spreadsheets, or <strong>CSV → PDF</strong> to generate formatted printable PDF reports.</li>
      <li><strong>Select Your Source PDF:</strong> Drag and drop your native PDF document into the dropzone above, or click to browse. The document name and size will be verified immediately.</li>
      <li><strong>Calibrate Gap Sensitivity:</strong> For standard statements, leave the sensitivity at <strong>Standard</strong>. If columns merge prematurely, select <strong>Tight</strong>.</li>
      <li><strong>Execute Client-Side Extraction:</strong> Click <strong>Extract Tables to CSV</strong>. The parser loops through document pages, reads text vector coordinates, groups rows, and builds your spreadsheet.</li>
      <li><strong>Download Clean CSV:</strong> Click the generated download button to save your formatted <code>.csv</code> spreadsheet.</li>
    </ol>

    <h2>Why PDFs Are Not Real Spreadsheets (The Vector Canvas Problem)</h2>
    <p>
      Many professionals assume a PDF table is structured like an HTML table with rows and cells. In reality, the Portable Document Format (PDF) is a visual printing specification created in 1993:
    </p>
    <ul>
      <li><strong>No Native Grid Semantics:</strong> A PDF has no concept of a "table", "tr", or "td". Text items are stored as independent drawing commands placed at arbitrary X and Y canvas points (e.g., <code>120.5 450.2 Td (Account Number) Tj</code>).</li>
      <li><strong>The Excel Clipboard Collapse:</strong> When you highlight text in Adobe Acrobat and paste into Microsoft Excel, the operating system clipboard dumps raw text strings without column delimiters, causing 5 distinct columns to cram into cell <code>A1</code>.</li>
      <li><strong>Spatial Reconstruction:</strong> To reliably extract data, our client-side engine calculates the baseline vertical position of each text fragment to group words into rows, then analyzes horizontal whitespace gaps across the entire page to deduce column boundaries.</li>
    </ul>

    <h2>Safe Bank Statement Conversion (The Zero-Upload Privacy Guarantee)</h2>
    <p>
      Converting financial statements (Chase, Bank of America, Wells Fargo, Stripe, PayPal) using generic online converters poses severe security risks:
    </p>
    <ul>
      <li><strong>Third-Party Cloud Storage:</strong> Most free PDF converters upload your document to remote cloud storage buckets where sensitive account numbers, balances, employee salaries, and addresses are retained.</li>
      <li><strong>Zero Server Uploads:</strong> Free CSV Toolbox runs 100% inside your local web browser. The PDF is read directly from your hard drive into your browser's ephemeral RAM. No bytes are sent over the network.</li>
      <li><strong>GDPR, CCPA &amp; Corporate Compliance:</strong> Because data never leaves your device, using this tool complies with strict corporate data governance policies that forbid sharing financial documents with unverified web services.</li>
    </ul>

    <h2>Developer Automation: Python &amp; Command-Line Alternatives</h2>
    <p>
      Developers handling high-volume PDF table extraction often script conversions using Python and Linux CLI utilities:
    </p>

    <h3>1. Python with pdfplumber (Accurate Bounding Box Extraction)</h3>
    <pre><code>import pdfplumber
import pandas as pd

# Open PDF and extract table structures
all_rows = []
with pdfplumber.open("bank_statement.pdf") as pdf:
    for page in pdf.pages:
        table = page.extract_table()
        if table:
            all_rows.extend(table)

# Export clean rows to CSV
df = pd.DataFrame(all_rows[1:], columns=all_rows[0])
df.to_csv("bank_statement_extracted.csv", index=False)
print("Extracted", len(df), "rows successfully.")</code></pre>

    <h3>2. Linux CLI: pdftotext (Layout Preservation)</h3>
    <pre><code># Extract text maintaining original visual table layout
pdftotext -layout input_statement.pdf statement_layout.txt

# Convert fixed-width column layout to CSV using awk
awk '&#123;print $1 "," $2 "," $3 "," $4&#125;' statement_layout.txt &gt; output.csv</code></pre>

    <h2>Edge-Case Troubleshooting &amp; Formatting Tips</h2>
    <p>
      Keep these critical table extraction considerations in mind:
    </p>
    <ul>
      <li><strong>Scanned Documents vs Digital PDFs:</strong> If your PDF is a scanned photocopy or smartphone picture, text cannot be selected with a mouse. Such documents require an Optical Character Recognition (OCR) pipeline.</li>
      <li><strong>Multi-Line Cell Wraps:</strong> Long transaction descriptions that wrap onto two lines within a single cell may initially register as two separate rows. You can clean these up using our <a href="/merge-csv/">CSV Merger</a> or spreadsheet text formulas.</li>
      <li><strong>Converting Spreadsheets to PDF:</strong> If you need to transform CSV datasets into beautiful, printable PDF tables, use our <a href="/csv-to-pdf/">CSV to PDF Converter</a>.</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <aside class="related">
      <strong>Related tools:</strong>
      <a href="/csv-to-pdf/">Convert CSV to PDF</a> ·
      <a href="/csv-to-json/">Convert CSV to JSON</a> ·
      <a href="/split-csv/">Split CSV files</a> ·
      <a href="/csv-viewer/">Large CSV Viewer</a> ·
      <a href="/guides/">All guides</a>
    </aside>
  </div>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script is:inline src="/js/tool-common.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var T = window.CSVTB, file = null;
      var $ = function (id) { return document.getElementById(id); };
      var dirSel = $('direction'), runBtn = $('run'), status = $('status'), resultsEl = $('results');
      var gapTolSel = $('gap-tolerance');

      if (window.pdfjsLib) {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }

      T.setupDirectionButtons('direction');

      dirSel.addEventListener('change', function () {
        var p2c = dirSel.value === 'p2c';
        $('dz-label').textContent = p2c ? 'Drop your PDF document here' : 'Drop your CSV file here';
        $('file-input').accept = p2c ? '.pdf,application/pdf' : '.csv,text/csv';
        runBtn.textContent = p2c ? 'Extract Tables to CSV' : 'Generate PDF Table';
        $('pdf-options').style.display = p2c ? 'flex' : 'none';
        file = null;
        $('file-name').hidden = true;
        runBtn.disabled = true;
      });

      T.setupDropzone('dropzone', 'file-input', function (files) {
        file = files[0];
        $('file-name').textContent = 'Selected: ' + file.name + ' (' + T.formatBytes(file.size) + ')';
        $('file-name').hidden = false;
        runBtn.disabled = false;
      });

      function cleanCell(str) {
        str = (str || '').trim();
        if (str.indexOf(',') !== -1 || str.indexOf('"') !== -1 || str.indexOf('\n') !== -1) {
          return '"' + str.replace(/"/g, '""') + '"';
        }
        return str;
      }

      async function extractPdfToCsv(pdfFile, gapTolerance) {
        var arrayBuffer = await pdfFile.arrayBuffer();
        var pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
        var totalPages = pdf.numPages;
        var allCsvRows = [];

        for (var pageNum = 1; pageNum <= totalPages; pageNum++) {
          status.textContent = 'Parsing page ' + pageNum + ' of ' + totalPages + '…';
          var page = await pdf.getPage(pageNum);
          var textContent = await page.getTextContent();
          var items = textContent.items;

          if (!items || items.length === 0) continue;

          // 1. Collect tokens with geometry
          var tokens = [];
          for (var i = 0; i < items.length; i++) {
            var it = items[i];
            if (!it.str || !it.str.trim()) continue;
            tokens.push({
              str: it.str,
              x: it.transform[4],
              y: it.transform[5],
              w: it.width,
              h: it.height
            });
          }

          // 2. Bin tokens into rows based on Y coordinate (within 4px tolerance)
          tokens.sort(function (a, b) { return b.y - a.y; });
          var rows = [];
          for (var t = 0; t < tokens.length; t++) {
            var tok = tokens[t];
            var placed = false;
            for (var r = 0; r < rows.length; r++) {
              if (Math.abs(rows[r].y - tok.y) <= 4.5) {
                rows[r].items.push(tok);
                placed = true;
                break;
              }
            }
            if (!placed) {
              rows.push({ y: tok.y, items: [tok] });
            }
          }

          // 3. For each row, sort items by X ascending and cluster cells based on horizontal gap
          for (var r = 0; r < rows.length; r++) {
            var rowItems = rows[r].items;
            rowItems.sort(function (a, b) { return a.x - b.x; });

            var cells = [];
            var currentCell = rowItems[0].str;
            var prevRight = rowItems[0].x + rowItems[0].w;

            for (var c = 1; c < rowItems.length; c++) {
              var item = rowItems[c];
              var gap = item.x - prevRight;

              if (gap > gapTolerance) {
                cells.push(cleanCell(currentCell));
                currentCell = item.str;
              } else {
                currentCell += (gap > 1.5 ? ' ' : '') + item.str;
              }
              prevRight = item.x + item.w;
            }
            cells.push(cleanCell(currentCell));

            if (cells.length > 0) {
              allCsvRows.push(cells.join(','));
            }
          }
        }

        return allCsvRows.join('\r\n');
      }

      runBtn.addEventListener('click', async function () {
        if (!file) return;
        resultsEl.innerHTML = '';
        runBtn.disabled = true;

        if (dirSel.value === 'p2c') {
          status.textContent = 'Initializing PDF engine…';
          try {
            var gap = parseFloat(gapTolSel.value) || 12;
            var csvContent = await extractPdfToCsv(file, gap);
            if (!csvContent || csvContent.trim().length === 0) {
              throw new Error('No readable text or tables detected. If this is a scanned photocopy or image, an OCR tool is required.');
            }
            var outName = file.name.replace(/\.[^.]+$/, '') + '_extracted.csv';
            T.addResult(resultsEl, { name: outName, content: csvContent });
            status.textContent = 'Extraction complete! Click Download below.';
          } catch (err) {
            status.textContent = 'Error: ' + err.message;
          } finally {
            runBtn.disabled = false;
          }
        } else {
          // Redirect to dedicated csv-to-pdf page or handle via forward
          window.location.href = '/csv-to-pdf/';
        }
      });
    });
  </script>
</Base>
