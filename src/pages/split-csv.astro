---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = [
  { q: 'How do I split a large CSV file without Excel?', a: 'Drop your file into the tool above, select your split criteria (by row count, maximum file size in megabytes, or unique column values), and click Split CSV. The engine processes chunks locally in your browser and provides instant downloads for each chunk or a single packaged ZIP.' },
  { q: 'Why does Excel crash or cut off my CSV at 1,048,576 rows?', a: 'Microsoft Excel has an internal grid architecture hard-coded to a maximum of 1,048,576 rows by 16,384 columns. When a CSV exceeds this limit, Excel truncates all subsequent records without warning. Our browser splitter bypasses spreadsheet grid constraints completely by streaming raw text.' },
  { q: 'Does each split file retain the original header row?', a: 'Yes. When "First row is a header" is checked, our Web Worker automatically captures the column names from row 1 and prepends them to the top of every generated split file, ensuring seamless importing into downstream databases or CRMs.' },
  { q: 'Can I split a CSV into separate files by category or country?', a: 'Yes. Switch the split mode to "By column value" and choose your target column (e.g., Country, State, Status, or Department). The tool parses the file and outputs an isolated, cleanly formatted CSV for every unique value in that column.' },
  { q: 'What is the maximum file size supported by this online splitter?', a: 'Because processing executes via client-side stream slicing in an isolated HTML5 Web Worker, files of 500MB to 1GB+ can be handled on standard consumer laptops without crashing the browser tab. The only limit is your local machine available RAM.' },
  { q: 'Is my confidential data uploaded or logged on any external server?', a: 'No. CSV Toolbox operates on a strict zero-upload architecture. Your spreadsheet never traverses the network; all parsing, splitting, and ZIP compression occur exclusively in your device local memory.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'CSV Splitter', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Free online tool to split CSV files by rows, file size or column value. Runs locally in the browser, no signup or upload required.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'CSV Splitter', item: pageUrl },
  ] },
];
---

<Base
  title="Split CSV Files Online Free — By Rows, Size or Column (No Signup)"
  description="Free online CSV splitter. Split large CSV files by number of rows, file size or column value, with headers kept in every part. No signup, no upload: runs privately in your browser."
  schema={schema}
>
  <div class="container">
    <h1>Split CSV Files Online</h1>
    <p class="lead">
      <strong>How do you split a large CSV file?</strong> Drop your spreadsheet below, choose to split by row count, maximum file size, or unique column values, and click Split CSV. Every generated part automatically preserves the original header row and downloads instantly. 100% free, no software installation, and your confidential data never leaves your device.
    </p>

    <div class="tool">
      <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Choose a CSV file or drag and drop it here">
        <p><strong>Drop your CSV file here</strong> or click to browse</p>
        <p class="muted">Processed locally — never uploaded</p>
      </div>
      <input type="file" id="file-input" accept=".csv,text/csv" />
      <p class="status" id="file-name" hidden></p>
      <div class="preview-wrap" id="preview" hidden></div>
      <div class="options">
        <label class="field">Split mode
          <select id="mode">
            <option value="rows">By number of rows</option>
            <option value="size">By max file size</option>
            <option value="column">By column value</option>
          </select>
        </label>
        <label class="field" id="opt-rows">Rows per file
          <input type="number" id="rows-per" name="rowsPer" value="1000" min="1" autocomplete="off" />
        </label>
        <label class="field" id="opt-size" hidden>Max size (MB)
          <input type="number" id="max-mb" name="maxMb" value="5" min="0.1" step="0.1" autocomplete="off" />
        </label>
        <label class="field" id="opt-column" hidden>Column
          <select id="column" name="column"></select>
        </label>
        <label class="checkbox"><input type="checkbox" id="keep-header" name="keepHeader" checked autocomplete="off" /> First row is a header (keep it in every part)</label>
      </div>
      <button class="btn" id="run" disabled>Split CSV</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
      <ul class="results" id="results"></ul>
      <button class="btn" id="zip" hidden>Download all as ZIP</button>
    </div>

    <AdSlot format="horizontal" />

    <h2>How to Split a CSV File (Step-by-Step Guide)</h2>
    <ol class="steps">
      <li><strong>Select or Drop Your File:</strong> Drag and drop your target CSV into the secure dropzone above, or click to browse your local filesystem. An instant 6-row table preview will render so you can verify column structures.</li>
      <li><strong>Configure Your Splitting Criteria:</strong> Choose between three operational modes:
        <ul>
          <li><strong>By number of rows:</strong> Divide massive datasets into manageable batches (e.g., exactly 100,000 rows per file for Excel or database batch insertion).</li>
          <li><strong>By maximum file size:</strong> Chunk files to stay strictly beneath upload size caps enforced by email providers, CRMs (HubSpot, Salesforce), or cloud databases (e.g., 10 MB per part).</li>
          <li><strong>By column value:</strong> Group records dynamically into dedicated CSV files according to discrete column categories (e.g., one file per country, sales territory, or order status).</li>
        </ul>
      </li>
      <li><strong>Preserve Table Schema:</strong> Leave <em>"First row is a header"</em> checked. This instructs the streaming parser to clone line 1 and inject it at the beginning of every split file.</li>
      <li><strong>Execute &amp; Export:</strong> Click <strong>Split CSV</strong>. Watch the real-time row counter stream through your data. Once completed, download parts individually or click <strong>Download all as ZIP</strong>.</li>
    </ol>

    <h2>Why Standard Spreadsheet Software Fails on Large CSVs</h2>
    <p>
      Desktop spreadsheet applications such as Microsoft Excel, Apple Numbers, and Google Sheets are engineered for visual formula calculation and desktop presentation, not high-volume tabular ETL. When attempting to open multi-hundred-megabyte CSV exports, desktop tools encounter severe architectural constraints:
    </p>
    <ul>
      <li><strong>The 1,048,576 Row Ceiling:</strong> Microsoft Excel’s worksheet engine is physically constrained to exactly 1,048,576 rows. If your database export contains 1,048,577 rows, Excel silently truncates the excess rows without throwing a blocking warning, resulting in corrupted analytics and silent data loss.</li>
      <li><strong>RAM Bloat &amp; System Freezes:</strong> Plaintext CSV files expand by 3x to 5x when converted into in-memory spreadsheet DOM trees. A 400 MB CSV export typically requires over 2.5 GB of RAM in Excel, frequently causing operating system spinning wheels, unhandled crash dialogs, and forced reboots.</li>
      <li><strong>Silent Type Coercion:</strong> Spreadsheets automatically evaluate alphanumeric strings, stripping leading zeros from critical identifiers like US ZIP codes (e.g., converting <code>01234</code> to <code>1234</code>), credit card numbers, and order tracking IDs.</li>
    </ul>

    <h2>Developer Automation: Command-Line &amp; Script Alternatives</h2>
    <p>
      If you are building automated data pipelines or working within headless server environments, you can replicate this splitting logic using standard developer toolchains:
    </p>

    <h3>1. Python &amp; Pandas (Chunked Memory Stream)</h3>
    <pre><code>import pandas as pd

# Stream through multi-gigabyte files in 100,000-row chunks
chunk_size = 100000
batch_num = 1

for chunk in pd.read_csv('massive_export.csv', chunksize=chunk_size, low_memory=False):
    output_filename = f"export_part_&#123;batch_num&#125;.csv"
    chunk.to_csv(output_filename, index=False)
    print(f"Generated &#123;output_filename&#125; with &#123;len(chunk)&#125; rows")
    batch_num += 1</code></pre>

    <h3>2. GNU Coreutils (Fast Linux / macOS Bash Split)</h3>
    <pre><code># Extract the original header row
head -n 1 massive_export.csv &gt; header.csv

# Split data rows into 100,000-line segments
tail -n +2 massive_export.csv | split -l 100000 - split_chunk_

# Re-attach header to every chunk
for file in split_chunk_*; do
    cat header.csv "$file" &gt; "final_$file.csv"
    rm "$file"
done
rm header.csv</code></pre>

    <h2>Edge-Case Troubleshooting &amp; Data Hygiene</h2>
    <p>
      Working with complex real-world CSV exports requires attention to common encoding and formatting traps:
    </p>
    <ul>
      <li><strong>UTF-8 Byte Order Marks (BOM):</strong> Some Windows systems export CSV files with an invisible 3-byte prefix (<code>\xef\xbb\xbf</code>). Our browser splitter automatically identifies and strips BOM headers so first-column names are not corrupted in downstream SQL schemas.</li>
      <li><strong>Escaped Multi-line Fields (RFC 4180):</strong> Naive line-splitting scripts break when customer feedback or addresses contain line breaks inside quotation marks. CSV Toolbox uses an RFC 4180 compliant finite-state parser that respects quoted text boundaries, ensuring multi-line cells stay intact within their respective parent rows.</li>
      <li><strong>Custom Separators:</strong> If your export uses semicolons, tabs, or pipe symbols instead of commas, run your file through our <a href="/change-delimiter-csv/">CSV Delimiter Converter</a> prior to splitting.</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <aside class="related">
      <strong>Related tools:</strong>
      <a href="/merge-csv/">Merge CSV files</a> ·
      <a href="/remove-duplicates-csv/">Remove duplicate rows</a> ·
      <a href="/change-delimiter-csv/">Change CSV delimiter</a> ·
      <a href="/csv-to-json/">Convert CSV to JSON</a> ·
      <a href="/guides/">All guides</a>
    </aside>
  </div>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" defer></script>
  <script is:inline src="/js/tool-common.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var T = window.CSVTB, file = null, results = [];
      var worker = new Worker('/workers/csv-worker.js');
      var $ = function (id) { return document.getElementById(id); };
      var modeSel = $('mode'), runBtn = $('run'), status = $('status'), resultsEl = $('results'), zipBtn = $('zip');

      T.setupDropzone('dropzone', 'file-input', function (files) {
        file = files[0];
        $('file-name').textContent = 'Selected: ' + file.name + ' (' + T.formatBytes(file.size) + ')';
        $('file-name').hidden = false;
        runBtn.disabled = false;
        T.previewCSV(file, $('preview'), 6);
        worker.postMessage({ op: 'headers', file: file });
      });

      modeSel.addEventListener('change', function () {
        $('opt-rows').hidden = modeSel.value !== 'rows';
        $('opt-size').hidden = modeSel.value !== 'size';
        $('opt-column').hidden = modeSel.value !== 'column';
      });

      worker.onmessage = function (e) {
        var d = e.data;
        if (d.type === 'headers') {
          $('column').innerHTML = d.headers.map(function (h) { return '<option>' + T.esc(h) + '</option>'; }).join('');
        } else if (d.type === 'progress') {
          status.textContent = 'Processing… ' + d.rows.toLocaleString() + ' rows read';
        } else if (d.type === 'file') {
          results.push(d);
          T.addResult(resultsEl, d);
        } else if (d.type === 'done') {
          status.textContent = 'Done — ' + d.rows.toLocaleString() + ' rows split into ' + d.parts + ' file' + (d.parts === 1 ? '' : 's') + '.';
          runBtn.disabled = false;
          if (results.length > 1) zipBtn.hidden = false;
        } else if (d.type === 'error') {
          status.textContent = 'Error: ' + d.message;
          runBtn.disabled = false;
        }
      };

      runBtn.addEventListener('click', function () {
        if (!file) return;
        results = [];
        resultsEl.innerHTML = '';
        zipBtn.hidden = true;
        runBtn.disabled = true;
        status.textContent = 'Processing…';
        var keep = $('keep-header').checked;
        if (modeSel.value === 'rows') {
          worker.postMessage({ op: 'split-rows', file: file, options: { rowsPerFile: Math.max(1, parseInt($('rows-per').value, 10) || 1000), hasHeader: keep, keepHeader: keep } });
        } else if (modeSel.value === 'size') {
          worker.postMessage({ op: 'split-size', file: file, options: { maxBytes: Math.max(0.1, parseFloat($('max-mb').value) || 5) * 1024 * 1024, hasHeader: keep, keepHeader: keep } });
        } else {
          worker.postMessage({ op: 'split-column', file: file, options: { column: $('column').value, keepHeader: keep } });
        }
      });

      zipBtn.addEventListener('click', function () {
        var zip = new JSZip();
        results.forEach(function (r) { zip.file(r.name, r.content); });
        zip.generateAsync({ type: 'blob' }).then(function (blob) { T.download('split-files.zip', blob); });
      });
    });
  </script>
</Base>
