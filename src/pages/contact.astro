---
import Base from '../layouts/Base.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact CSV Toolbox',
    url: pageUrl,
    description: 'Contact CSV Toolbox with technical inquiries, partnership questions, bug reports, or feature suggestions.',
    mainEntity: {
      '@type': 'Organization',
      name: 'CSV Toolbox',
      url: Astro.site?.toString(),
      email: 'freecsvtoolbox@gmail.com',
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'freecsvtoolbox@gmail.com',
        contactType: 'Customer Support'
      }
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: pageUrl }
    ]
  }
];
---

<Base
  title="Contact CSV Toolbox — Support, Bug Reports & Feature Requests"
  description="Contact the CSV Toolbox engineering team with questions, bug reports, feature requests, or custom delimiter suggestions."
  schema={schema}
>
  <div class="container guide">
    <h1>Contact</h1>
    <p>Questions, bug reports or ideas for a new tool? We would love to hear from you.</p>
    <ul>
      <li>
        <strong>Issues &amp; feature requests:</strong>
        <a href="https://github.com/Dx1100/csv-toolbox/issues" target="_blank" rel="noopener noreferrer">open an issue on GitHub</a> (recommended for fast tracking)
      </li>
      <li>
        <strong>Email:</strong>
        <a href="mailto:freecsvtoolbox@gmail.com">freecsvtoolbox@gmail.com</a>
      </li>
    </ul>
    <p>
      Reporting a problem with a specific file? Please describe the file's structure (columns,
      approximate size, delimiter) rather than sending the file itself — remember, we never see
      your data because processing happens in your browser.
    </p>
  </div>
</Base>
