---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = [
  { q: 'How do I convert a CSV file to a Markdown table?', a: 'Select "CSV → Markdown" from the direction menu, drop your CSV or TSV file, and click Convert. The tool parses column headers, inserts a standard GitHub Flavored Markdown (GFM) separator row (| --- | --- |), escapes reserved pipe characters, and outputs a formatted Markdown table (.md).' },
  { q: 'How do I convert a Markdown table back into a CSV file?', a: 'Select "Markdown → CSV", upload or drop your Markdown file (.md, .markdown, or .txt), and click Convert. The converter identifies the table structure, removes alignment markers, restores escaped pipe symbols and line breaks, and exports a standard RFC 4180 CSV spreadsheet.' },
  { q: 'What Markdown table syntax does this tool generate and accept?', a: 'The tool uses standard GitHub Flavored Markdown (GFM) pipe-table syntax. This format is natively supported by GitHub, GitLab, Reddit, Notion, Obsidian, Dev.to, Static Site Generators (Astro, Hugo, Jekyll), and standard Markdown parsers.' },
  { q: 'How are vertical pipes ("|") and multiline breaks in cells handled?', a: 'When converting CSV to Markdown, literal vertical pipes are escaped as "\\|" to prevent column splitting, and newlines within cells are replaced with HTML "<br>" tags. When converting Markdown back to CSV, "\\|" is decoded back to "|" and "<br>" tags are restored to genuine line breaks.' },
  { q: 'What file types can I upload for Markdown to CSV conversion?', a: 'You can upload .md, .markdown, or .txt files. You can even paste a Markdown table into a text file and drop it in. The parser extracts the tabular lines and ignores external text or headers.' },
  { q: 'Can I convert Markdown tables copied from GitHub READMEs or Notion?', a: 'Yes. Any pipe-delimited table copied from a README, documentation page, or Notion export can be saved as a .md or .txt file and converted directly into a clean CSV spreadsheet.' },
  { q: 'Is my data or file uploaded to any remote server?', a: 'No. All processing occurs 100% locally in your web browser via a client-side Web Worker. Your CSV and Markdown data never leaves your device, ensuring complete confidentiality.' }
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'CSV ⇄ Markdown Table Converter', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Free online CSV to Markdown and Markdown to CSV converter. Convert tabular data into GitHub Flavored Markdown tables and back locally in browser.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'CSV ⇄ Markdown', item: pageUrl },
  ] },
];
---

<Base
  title="CSV ⇄ Markdown Table Converter Online Free — Both Directions"
  description="Convert CSV files to formatted Markdown tables, or convert Markdown tables back to CSV. Standard GitHub-flavored markdown. Free, fast, and processed locally in your browser."
  schema={schema}
>
  <div class="container">
    <h1>CSV ⇄ Markdown Table Converter</h1>
    <p class="lead">
      <strong>Need to convert between CSV files and Markdown tables?</strong> 
      Convert spreadsheet rows into clean GitHub-flavored Markdown tables, or extract tabular data from Markdown documents back into standard CSV. 
      Runs 100% locally in your browser for complete privacy.
    </p>

    <div class="tool">
      <div class="direction-container">
        <div class="direction-info">
          <span class="direction-badge"><span class="direction-badge-dot"></span> Conversion Direction</span>
          <p class="direction-label">Select conversion mode:</p>
        </div>
        <div class="direction-btn-group" role="tablist" aria-label="Conversion Direction">
          <button type="button" class="direction-btn active" data-dir="c2m" role="tab" aria-selected="true">
            <span>CSV</span> <span class="arrow-icon">→</span> <span>Markdown</span>
          </button>
          <button type="button" class="direction-btn" data-dir="m2c" role="tab" aria-selected="false">
            <span>Markdown</span> <span class="arrow-icon">→</span> <span>CSV</span>
          </button>
        </div>
        <select id="direction" class="direction-select-sync" aria-label="Conversion direction">
          <option value="c2m" selected>CSV → Markdown</option>
          <option value="m2c">Markdown → CSV</option>
        </select>
      </div>

      <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Choose a file or drag and drop it here">
        <p><strong id="dz-label">Drop your CSV file here</strong> or click to browse</p>
        <p class="muted">Processed locally — never uploaded</p>
      </div>
      <input type="file" id="file-input" accept=".csv,text/csv,.tsv,.txt" />
      <p class="status" id="file-name" hidden></p>
      <div class="preview-wrap" id="preview" hidden></div>
      
      <button class="btn" id="run" disabled>Convert</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
      <ul class="results" id="results"></ul>
    </div>

    <AdSlot format="horizontal" />

    <h2>How the Bidirectional Conversion Works (Step-by-Step Guide)</h2>
    
    <h3>Direction 1: Converting CSV to Markdown Table</h3>
    <ol class="steps">
      <li><strong>Select "CSV → Markdown":</strong> Choose this mode from the direction controls above.</li>
      <li><strong>Add your CSV or TSV file:</strong> Drag and drop your file into the box. A live preview of the top rows appears immediately.</li>
      <li><strong>Run the conversion:</strong> Click Convert. The tool reads your header row to define column names, adds a GFM separator row (<code>| --- | --- |</code>), wraps each row with pipe delimiters, and safely escapes internal pipes (<code>\|</code>) and line breaks (<code>&lt;br&gt;</code>).</li>
      <li><strong>Download or copy:</strong> Download your clean <code>.md</code> file or open it to copy the table directly into README files, documentation, or blog posts.</li>
    </ol>

    <h3>Direction 2: Converting Markdown Table to CSV</h3>
    <ol class="steps">
      <li><strong>Select "Markdown → CSV":</strong> Switch the direction toggle to enable Markdown table extraction.</li>
      <li><strong>Upload your Markdown file:</strong> Drop your <code>.md</code>, <code>.markdown</code>, or <code>.txt</code> file containing a pipe-delimited table.</li>
      <li><strong>Extract spreadsheet rows:</strong> Click Convert. The parser scans the file, detects the table boundary, isolates column headers, discards formatting separator rows (e.g. <code>|:---|---:|</code>), unescapes pipe characters, and formats the output into standard comma-separated values.</li>
      <li><strong>Download your CSV:</strong> Save the resulting <code>.csv</code> file, ready for Excel, Google Sheets, Pandas, or database imports.</li>
    </ol>

    <h2>Why Manual Copy-Pasting Between Excel and Markdown Fails</h2>
    <p>
      Technical writers, open-source maintainers, and developers frequently need to publish tabular benchmarks in GitHub READMEs or Notion wikis. Copy-pasting directly from spreadsheets causes structural syntax errors:
    </p>
    <ul>
      <li><strong>Broken Pipe Delimiters:</strong> Markdown tables rely exclusively on vertical pipe characters (<code>|</code>) as cell dividers. If your cell values contain pipe characters (such as regex statements, Linux pipe commands, or logical OR operators), naive converters fail to escape them, causing tables to shatter into fragmented, misaligned columns.</li>
      <li><strong>Newline Truncation:</strong> In GitHub Flavored Markdown (GFM), a raw line break signals the start of a completely new row. Cell descriptions with embedded paragraphs immediately break table formatting unless converted to inline HTML <code>&lt;br&gt;</code> tags.</li>
      <li><strong>Missing Separator Syntax:</strong> Unlike HTML, Markdown requires a rigid delimiter alignment line (<code>| --- | --- |</code>) between row 1 and the data rows. Manual text formatting invariably misses trailing pipes, causing Markdown renderers to treat tables as unformatted raw text.</li>
    </ul>

    <h2>Developer Automation: Command-Line &amp; Script Alternatives</h2>
    <p>
      For continuous documentation pipelines, developers automate CSV-to-Markdown conversions using Python or terminal scripts:
    </p>

    <h3>1. Python &amp; Pandas (Native Markdown Export)</h3>
    <pre><code>import pandas as pd

# Load CSV and serialize to GFM Markdown table
df = pd.read_csv("benchmarks.csv")
markdown_table = df.to_markdown(index=False)

with open("BENCHMARKS.md", "w", encoding="utf-8") as f:
    f.write(markdown_table)

print("Generated GitHub-compliant Markdown table.")</code></pre>

    <h3>2. Linux CLI (Fast Awk Pipe Formatter)</h3>
    <pre><code># Quick terminal conversion of CSV to basic Markdown pipe table
awk -F',' 'BEGIN &#123;OFS=" | "&#125;
NR==1 &#123;
  print "| " $0 " |";
  for (i=1; i&lt;=NF; i++) sep[i]="---";
  print "| " sep[1], sep[2], sep[3] " |"
&#125;
NR&gt;1 &#123;print "| " $0 " |"&#125;' input.csv &gt; output.md</code></pre>

    <h2>Edge-Case Troubleshooting &amp; Formatting Tips</h2>
    <p>
      Ensure clean Markdown rendering across diverse hosting platforms with these checks:
    </p>
    <ul>
      <li><strong>Column Alignment Syntax:</strong> GFM supports text justification using colons: <code>| :--- |</code> for left-aligned, <code>| :---: |</code> for centered, and <code>| ---: |</code> for right-aligned numbers.</li>
      <li><strong>Handling Raw HTML Inside Cells:</strong> If your cells contain bold, italics, or hyperlinks, GFM parses them cleanly inside pipe rows without requiring extra escaping.</li>
      <li><strong>Need HTML Instead?</strong> If your content management system requires raw table markup rather than Markdown, try our <a href="/csv-to-html/">CSV to HTML Table Converter</a>.</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <aside class="related">
      <strong>Related tools:</strong>
      <a href="/split-csv/">Split CSV files</a> ·
      <a href="/csv-to-html/">CSV ⇄ HTML</a> ·
      <a href="/csv-to-json/">CSV ⇄ JSON</a> ·
      <a href="/csv-to-yaml/">CSV ⇄ YAML</a> ·
      <a href="/guides/">All guides</a>
    </aside>
  </div>

  <script is:inline src="/js/tool-common.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var T = window.CSVTB, file = null;
      var worker = new Worker('/workers/csv-worker.js');
      var $ = function (id) { return document.getElementById(id); };
      var dirSel = $('direction'), runBtn = $('run'), status = $('status'), resultsEl = $('results');
      T.setupDirectionButtons('direction');

      dirSel.addEventListener('change', function () {
        var c2m = dirSel.value === 'c2m';
        $('dz-label').textContent = c2m ? 'Drop your CSV file here' : 'Drop your Markdown (.md, .txt) file here';
        $('file-input').accept = c2m ? '.csv,text/csv,.tsv,.txt' : '.md,.markdown,.txt';
        file = null;
        $('file-name').hidden = true;
        $('preview').hidden = true;
        runBtn.disabled = true;
        resultsEl.innerHTML = '';
        status.textContent = '';
      });

      T.setupDropzone('dropzone', 'file-input', function (files) {
        file = files[0];
        $('file-name').textContent = 'Selected: ' + file.name + ' (' + T.formatBytes(file.size) + ')';
        $('file-name').hidden = false;
        runBtn.disabled = false;
        if (dirSel.value === 'c2m') {
          T.previewCSV(file, $('preview'), 6);
        } else {
          T.previewText(file, $('preview'), 8);
        }
      });

      worker.onmessage = function (e) {
        var d = e.data;
        if (d.type === 'file') {
          T.addResult(resultsEl, d);
        } else if (d.type === 'done') {
          var targetFmt = dirSel.value === 'c2m' ? 'Markdown' : 'CSV';
          status.textContent = 'Done — successfully converted ' + d.rows.toLocaleString() + ' rows to ' + targetFmt + '.';
          runBtn.disabled = false;
        } else if (d.type === 'error') {
          status.textContent = 'Error: ' + d.message;
          runBtn.disabled = false;
        }
      };

      runBtn.addEventListener('click', function () {
        if (!file) return;
        resultsEl.innerHTML = '';
        runBtn.disabled = true;
        status.textContent = 'Converting…';
        worker.postMessage({ 
          op: dirSel.value === 'c2m' ? 'csv-to-markdown' : 'markdown-to-csv', 
          file: file 
        });
      });
    });
  </script>
</Base>
