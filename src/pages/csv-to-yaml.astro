---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = [
  { q: 'How do I convert a CSV file to YAML?', a: 'Select "CSV → YAML" from the direction menu, drop your CSV file, and click Convert. The tool maps your CSV header row to YAML object keys and outputs a clean, indented YAML array of records (.yaml).' },
  { q: 'How do I convert a YAML file back to CSV?', a: 'Select "YAML → CSV", upload your YAML document (.yaml or .yml), and click Convert. The parser reads the array of items, collects all unique property keys to establish column headers, and exports a standard RFC 4180 CSV spreadsheet.' },
  { q: 'What YAML structure does the CSV to YAML converter produce?', a: 'It produces a standard list of associative mappings (an array of objects). Each row starts with a hyphen ("- ") representing a record, with indented "key: value" pairs corresponding to the CSV columns.' },
  { q: 'What YAML format is expected when converting YAML to CSV?', a: 'The parser expects a YAML list/sequence of mappings (e.g. records beginning with "- "). Each entry is treated as a row, with its keys aligned to CSV column headers.' },
  { q: 'How are special characters like colons, hyphens, and newlines handled in YAML?', a: 'When converting CSV to YAML, values containing colons, dashes, quotes, leading/trailing whitespace, or newlines are automatically quoted and escaped so the generated YAML complies strictly with YAML 1.2 specifications.' },
  { q: 'Can I use the generated YAML in Kubernetes, Docker Compose, or CI/CD pipelines?', a: 'Yes. The output is standard valid YAML, making it ideal for populating configuration manifests, test fixtures, data seeding, or DevOps orchestration files.' },
  { q: 'Is my data or configuration file uploaded to any server?', a: 'No. All conversions happen entirely client-side in your web browser via a background Web Worker. Your files and configuration values never leave your computer.' }
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'CSV ⇄ YAML Converter', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Free online CSV to YAML and YAML to CSV converter. Converts comma-separated values to indented YAML blocks and vice versa locally in browser.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'CSV ⇄ YAML', item: pageUrl },
  ] },
];
---

<Base
  title="CSV ⇄ YAML Converter Online Free — Both Directions"
  description="Convert your CSV datasets into clean YAML configurations, or convert YAML files back to standard CSV. Formatted indentation, secure client-side processing, no signups."
  schema={schema}
>
  <div class="container">
    <h1>CSV ⇄ YAML Converter Online</h1>
    <p class="lead">
      <strong>Need to convert between CSV spreadsheets and YAML configuration files?</strong> 
      Convert CSV tabular rows into clean YAML documents, or parse YAML lists into standard CSV files. 
      Runs 100% locally in your web browser for absolute security and rapid performance.
    </p>

    <div class="tool">
      <div class="direction-container">
        <div class="direction-info">
          <span class="direction-badge"><span class="direction-badge-dot"></span> Conversion Direction</span>
          <p class="direction-label">Select conversion mode:</p>
        </div>
        <div class="direction-btn-group" role="tablist" aria-label="Conversion Direction">
          <button type="button" class="direction-btn active" data-dir="c2y" role="tab" aria-selected="true">
            <span>CSV</span> <span class="arrow-icon">→</span> <span>YAML</span>
          </button>
          <button type="button" class="direction-btn" data-dir="y2c" role="tab" aria-selected="false">
            <span>YAML</span> <span class="arrow-icon">→</span> <span>CSV</span>
          </button>
        </div>
        <select id="direction" class="direction-select-sync" aria-label="Conversion direction">
          <option value="c2y" selected>CSV → YAML</option>
          <option value="y2c">YAML → CSV</option>
        </select>
      </div>

      <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Choose a file or drag and drop it here">
        <p><strong id="dz-label">Drop your CSV file here</strong> or click to browse</p>
        <p class="muted">Processed locally — never uploaded</p>
      </div>
      <input type="file" id="file-input" accept=".csv,text/csv,.tsv,.txt" />
      <p class="status" id="file-name" hidden></p>
      <div class="preview-wrap" id="preview" hidden></div>
      
      <button class="btn" id="run" disabled>Convert</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
      <ul class="results" id="results"></ul>
    </div>

    <AdSlot format="horizontal" />

    <h2>How the Bidirectional Conversion Works (Step-by-Step Guide)</h2>
    
    <h3>Direction 1: Converting CSV to YAML</h3>
    <ol class="steps">
      <li><strong>Select "CSV → YAML":</strong> Choose this mode from the direction dropdown above.</li>
      <li><strong>Add your CSV file:</strong> Drag and drop your <code>.csv</code> or <code>.tsv</code> file. The preview table confirms headers and initial rows.</li>
      <li><strong>Convert to structured YAML:</strong> Click Convert. The tool parses headers as object property keys, formats each record into a YAML list item (starting with <code>- </code>), properly quotes strings with colons or special symbols, and outputs standard YAML.</li>
      <li><strong>Download your YAML:</strong> Save the output as a <code>.yaml</code> or <code>.yml</code> file, ready for configuration management or API seeding.</li>
    </ol>

    <h3>Direction 2: Converting YAML to CSV</h3>
    <ol class="steps">
      <li><strong>Select "YAML → CSV":</strong> Switch the direction dropdown to enable YAML-to-CSV conversion.</li>
      <li><strong>Upload your YAML document:</strong> Drop your <code>.yaml</code>, <code>.yml</code>, or <code>.txt</code> file containing a list of records.</li>
      <li><strong>Extract tabular columns:</strong> Click Convert. The worker uses JS-YAML to load the data structure, aggregates all unique keys across records to create a unified header row, and unparses values into comma-separated rows.</li>
      <li><strong>Download your CSV:</strong> Save the converted file as a clean <code>.csv</code> spreadsheet for Excel, Google Sheets, or data pipelines.</li>
    </ol>

    <h2>Why Spreadsheets Fail with DevOps &amp; Configuration YAML</h2>
    <p>
      Modern infrastructure tools (Kubernetes, Ansible, GitHub Actions, Docker Compose) depend entirely on strict whitespace-delimited YAML formatting. Traditional spreadsheets cannot interact with YAML natively:
    </p>
    <ul>
      <li><strong>Whitespace Indentation Sensitivity:</strong> YAML uses exact 2-space indentation to define data hierarchy. Tabs and improper alignment cause immediate syntax parser crashes (<code>mapping values are not allowed here</code>). Desktop spreadsheet tools do not respect or export hierarchical indentation.</li>
      <li><strong>Colon and Type Ambiguities:</strong> Values containing colons (like URLs <code>https://api.com</code>, timestamps, or IP addresses) must be explicitly quoted in YAML to avoid being evaluated as unquoted dictionary keys. CSV Toolbox safely wraps special characters in compliant double quotes.</li>
      <li><strong>Boolean and Reserved Keyword Traps:</strong> Unquoted words like <code>yes</code>, <code>no</code>, <code>on</code>, <code>off</code>, <code>true</code>, and <code>false</code> are coerced into boolean flags under YAML 1.1 specs. Our tool handles string quoting reliably.</li>
    </ul>

    <h2>Developer Automation: Command-Line &amp; Script Alternatives</h2>
    <p>
      Engineers automate conversions between CSV and YAML using Python:
    </p>

    <h3>1. Python (CSV to Clean YAML List)</h3>
    <pre><code>import csv
import yaml

# Ingest CSV records and serialize to YAML
with open("servers.csv", "r", encoding="utf-8") as f:
    records = list(csv.DictReader(f))

with open("servers.yaml", "w", encoding="utf-8") as f:
    yaml.dump(records, f, sort_keys=False, default_flow_style=False)

print("Generated structured YAML configuration.")</code></pre>

    <h3>2. Python (YAML Array to Standard CSV)</h3>
    <pre><code>import csv
import yaml

with open("config.yaml", "r", encoding="utf-8") as f:
    data = yaml.safe_load(f)

if isinstance(data, list) and len(data) &gt; 0:
    keys = data[0].keys()
    with open("config.csv", "w", encoding="utf-8", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=keys)
        writer.writeheader()
        writer.writerows(data)</code></pre>

    <h2>Edge-Case Troubleshooting &amp; Formatting Tips</h2>
    <p>
      When transforming configurations between tabular and YAML representations:
    </p>
    <ul>
      <li><strong>Multi-Document YAML Files:</strong> If your YAML file contains multiple documents separated by <code>---</code>, our parser extracts the primary list structure cleanly.</li>
      <li><strong>Preserving Numbers as Strings:</strong> Numerical configuration values (such as port numbers or version strings like <code>1.0</code>) are safely quoted to prevent floating-point truncation.</li>
      <li><strong>JSON Alternative:</strong> Need standard web JSON instead of indentation-based YAML? Try our <a href="/csv-to-json/">CSV to JSON Converter</a>.</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <aside class="related">
      <strong>Related tools:</strong>
      <a href="/split-csv/">Split CSV files</a> ·
      <a href="/merge-csv/">Merge CSV files</a> ·
      <a href="/csv-to-json/">CSV ⇄ JSON</a> ·
      <a href="/csv-to-markdown/">CSV ⇄ Markdown</a> ·
      <a href="/csv-to-html/">CSV ⇄ HTML</a>
    </aside>
  </div>

  <script is:inline src="/js/tool-common.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var T = window.CSVTB, file = null;
      var worker = new Worker('/workers/csv-worker.js');
      var $ = function (id) { return document.getElementById(id); };
      var dirSel = $('direction'), runBtn = $('run'), status = $('status'), resultsEl = $('results');
      T.setupDirectionButtons('direction');

      dirSel.addEventListener('change', function () {
        var c2y = dirSel.value === 'c2y';
        $('dz-label').textContent = c2y ? 'Drop your CSV file here' : 'Drop your YAML (.yaml, .yml) file here';
        $('file-input').accept = c2y ? '.csv,text/csv,.tsv,.txt' : '.yaml,.yml,.txt';
        file = null;
        $('file-name').hidden = true;
        $('preview').hidden = true;
        runBtn.disabled = true;
        resultsEl.innerHTML = '';
        status.textContent = '';
      });

      T.setupDropzone('dropzone', 'file-input', function (files) {
        file = files[0];
        $('file-name').textContent = 'Selected: ' + file.name + ' (' + T.formatBytes(file.size) + ')';
        $('file-name').hidden = false;
        runBtn.disabled = false;
        if (dirSel.value === 'c2y') {
          T.previewCSV(file, $('preview'), 6);
        } else {
          T.previewText(file, $('preview'), 8);
        }
      });

      worker.onmessage = function (e) {
        var d = e.data;
        if (d.type === 'progress') {
          status.textContent = 'Converting… ' + d.rows.toLocaleString() + ' rows read';
        } else if (d.type === 'file') {
          T.addResult(resultsEl, d);
        } else if (d.type === 'done') {
          var targetFmt = dirSel.value === 'c2y' ? 'YAML' : 'CSV';
          status.textContent = 'Done — successfully converted ' + d.rows.toLocaleString() + ' rows to ' + targetFmt + '.';
          runBtn.disabled = false;
        } else if (d.type === 'error') {
          status.textContent = 'Error: ' + d.message;
          runBtn.disabled = false;
        }
      };

      runBtn.addEventListener('click', function () {
        if (!file) return;
        resultsEl.innerHTML = '';
        runBtn.disabled = true;
        status.textContent = 'Converting…';
        worker.postMessage({ 
          op: dirSel.value === 'c2y' ? 'csv-to-yaml' : 'yaml-to-csv', 
          file: file 
        });
      });
    });
  </script>
</Base>
