---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = [
  { q: 'How do I convert a CSV file to YAML?', a: 'Select "CSV → YAML", choose your CSV file, and click Convert. The converter maps headers to YAML keys for each record, compiling them into a list of YAML objects. Download the output directly.' },
  { q: 'How do I convert a YAML file to CSV?', a: 'Select "YAML → CSV", upload your YAML document (.yaml or .yml), and click Convert. The tool parses the YAML array of records, unifies keys into columns, and downloads a clean CSV file.' },
  { q: 'What is the structure of the converted YAML file?', a: 'It produces a standard list of objects (associative arrays represented by indented key-value pairs). Each row starts with a hyphen ("-") to indicate an array item, and contains properties matching the CSV columns.' },
  { q: 'Are my CSV or YAML files uploaded to any servers?', a: 'No. The converter parses your files locally inside your web browser. No data leaves your machine, ensuring full data privacy.' },
  { q: 'Can it convert large CSV and YAML configurations?', a: 'Yes. The parser handles large files smoothly in a Web Worker, ensuring your browser remains responsive throughout the process.' }
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'CSV ⇄ YAML Converter', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Free online CSV to YAML and YAML to CSV converter. Converts comma-separated values to indented YAML blocks and vice versa locally in browser.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'CSV ⇄ YAML', item: pageUrl },
  ] },
];
---

<Base
  title="CSV ⇄ YAML Converter Online Free — Both Directions"
  description="Convert your CSV datasets into clean YAML configurations, or convert YAML files back to standard CSV. Formatted indentation, secure client-side processing, no signups."
  schema={schema}
>
  <div class="container">
    <h1>CSV ⇄ YAML Converter Online</h1>
    <p class="lead">
      <strong>Need to convert between CSV spreadsheets and YAML configuration files?</strong> 
      Convert CSV tabular rows into clean YAML documents, or parse YAML lists into standard CSV files. 
      Runs 100% locally in your web browser for absolute security and rapid performance.
    </p>

    <div class="tool">
      <div class="options">
        <label class="field">Direction
          <select id="direction">
            <option value="c2y">CSV → YAML</option>
            <option value="y2c">YAML → CSV</option>
          </select>
        </label>
      </div>

      <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Choose a file or drag and drop it here">
        <p><strong id="dz-label">Drop your CSV file here</strong> or click to browse</p>
        <p class="muted">Processed locally — never uploaded</p>
      </div>
      <input type="file" id="file-input" accept=".csv,text/csv,.tsv,.txt" />
      <p class="status" id="file-name" hidden></p>
      <div class="preview-wrap" id="preview" hidden></div>
      
      <button class="btn" id="run" disabled>Convert</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
      <ul class="results" id="results"></ul>
    </div>

    <AdSlot />

    <h2>How the conversion works</h2>
    <ol class="steps">
      <li><strong>Choose direction:</strong> Select <em>CSV → YAML</em> to convert spreadsheet records to YAML, or <em>YAML → CSV</em> to extract structured YAML files back to CSV.</li>
      <li><strong>Add your file:</strong> Drag a <code>.csv</code>, <code>.tsv</code>, <code>.yaml</code>, or <code>.yml</code> file into the dropzone. Verify the preview.</li>
      <li><strong>Start conversion:</strong> Click Convert to parse records in a background Web Worker.</li>
      <li><strong>Download your document:</strong> Click download to save your new <code>.yaml</code> or <code>.csv</code> file directly.</li>
    </ol>

    <h2>Why choose our browser-based YAML converter?</h2>
    <ul>
      <li><strong>Bidirectional Conversion:</strong> Move freely back and forth between CSV spreadsheets and YAML configuration files.</li>
      <li><strong>Proper Quote Escapes:</strong> Handles cells with colons, hyphens, and newlines by quoting values correctly so the YAML parses cleanly in Kubernetes, docker-compose, or CI/CD pipelines.</li>
      <li><strong>Nested Structure Handling:</strong> Flattens or serializes nested YAML properties cleanly so tabular structures remain readable.</li>
    </ul>

    <h2>Frequently asked questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <aside class="related">
      <strong>Related tools:</strong>
      <a href="/split-csv/">Split CSV files</a> ·
      <a href="/merge-csv/">Merge CSV files</a> ·
      <a href="/csv-to-json/">CSV ⇄ JSON</a> ·
      <a href="/csv-to-markdown/">CSV ⇄ Markdown</a> ·
      <a href="/csv-to-html/">CSV ⇄ HTML</a>
    </aside>
  </div>

  <script is:inline src="/js/tool-common.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var T = window.CSVTB, file = null;
      var worker = new Worker('/workers/csv-worker.js');
      var $ = function (id) { return document.getElementById(id); };
      var dirSel = $('direction'), runBtn = $('run'), status = $('status'), resultsEl = $('results');

      dirSel.addEventListener('change', function () {
        var c2y = dirSel.value === 'c2y';
        $('dz-label').textContent = c2y ? 'Drop your CSV file here' : 'Drop your YAML (.yaml, .yml) file here';
        $('file-input').accept = c2y ? '.csv,text/csv,.tsv,.txt' : '.yaml,.yml,.txt';
        file = null;
        $('file-name').hidden = true;
        $('preview').hidden = true;
        runBtn.disabled = true;
        resultsEl.innerHTML = '';
        status.textContent = '';
      });

      T.setupDropzone('dropzone', 'file-input', function (files) {
        file = files[0];
        $('file-name').textContent = 'Selected: ' + file.name + ' (' + T.formatBytes(file.size) + ')';
        $('file-name').hidden = false;
        runBtn.disabled = false;
        if (dirSel.value === 'c2y') {
          T.previewCSV(file, $('preview'), 6);
        } else {
          T.previewText(file, $('preview'), 8);
        }
      });

      worker.onmessage = function (e) {
        var d = e.data;
        if (d.type === 'progress') {
          status.textContent = 'Converting… ' + d.rows.toLocaleString() + ' rows read';
        } else if (d.type === 'file') {
          T.addResult(resultsEl, d);
        } else if (d.type === 'done') {
          var targetFmt = dirSel.value === 'c2y' ? 'YAML' : 'CSV';
          status.textContent = 'Done — successfully converted ' + d.rows.toLocaleString() + ' rows to ' + targetFmt + '.';
          runBtn.disabled = false;
        } else if (d.type === 'error') {
          status.textContent = 'Error: ' + d.message;
          runBtn.disabled = false;
        }
      };

      runBtn.addEventListener('click', function () {
        if (!file) return;
        resultsEl.innerHTML = '';
        runBtn.disabled = true;
        status.textContent = 'Converting…';
        worker.postMessage({ 
          op: dirSel.value === 'c2y' ? 'csv-to-yaml' : 'yaml-to-csv', 
          file: file 
        });
      });
    });
  </script>
</Base>
