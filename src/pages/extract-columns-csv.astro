---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = [
  { q: 'How do I extract specific columns from a CSV file online?', a: 'Upload your file into the tool above, inspect the automatically detected headers, select the checkboxes for the columns you wish to retain, and click Extract Columns. The browser engine parses each row, filters out unselected fields, and downloads your streamlined CSV instantly.' },
  { q: 'Can I remove or delete unwanted columns from a large CSV file?', a: 'Yes. Use the Deselect All button, then check only the columns you need—or uncheck individual bloated columns (such as tracking logs, internal IDs, or marketing tags). This is the fastest way to prune bloated Salesforce or Shopify exports.' },
  { q: 'Does this tool preserve the original data types and headers of extracted columns?', a: 'Yes. Every selected column retains its exact original header label and raw cell values, including leading zeros, special characters, and formatting, without automated spreadsheet type coercion.' },
  { q: 'How many columns can this tool process at once?', a: 'There is no hard limit. You can upload enterprise datasets containing 100 to 300+ columns. The interface renders an organized, searchable column selection grid with convenient Select All and Deselect All shortcuts.' },
  { q: 'What is the maximum file size for CSV column filtering?', a: 'Because processing is executed via client-side streaming in a dedicated HTML5 Web Worker, multi-hundred-megabyte files can be filtered smoothly without freezing your operating system or crashing the browser tab.' },
  { q: 'Are my confidential CRM or financial records uploaded to an external server?', a: 'Never. All column extraction and row filtering occur 100% locally in your machine memory. No data is transmitted across the internet, ensuring full compliance with GDPR and corporate security protocols.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'CSV Column Extractor', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Free online tool to extract specific columns or remove columns from CSV files. Runs locally in the browser with no upload required.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'Extract CSV Columns', item: pageUrl },
  ] },
];
---

<Base
  title="Extract Columns from CSV Online Free — Filter CSV Columns (No Signup)"
  description="Free online CSV column extractor. Extract or remove specific columns from large CSV files in your browser. No signup, no file upload: runs privately and fast."
  schema={schema}
>
  <div class="container">
    <h1>Extract Columns from CSV Online</h1>
    <p class="lead">
      <strong>How do you extract specific columns from a CSV file without Excel?</strong> Drop your spreadsheet below, check the exact columns you need to retain, and click Extract Columns. Easily strip bloated CRM exports, isolate primary keys, and trim 80% of file weight in seconds. 100% free, private, and client-side.
    </p>

    <div class="tool">
      <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Choose a CSV file or drag and drop it here">
        <p><strong>Drop your CSV file here</strong> or click to browse</p>
        <p class="muted">Processed locally — never uploaded</p>
      </div>
      <input type="file" id="file-input" accept=".csv,text/csv,.tsv,.txt" />
      <p class="status" id="file-name" hidden></p>
      <div class="preview-wrap" id="preview" hidden></div>
      
      <div class="options-wrap" id="options-section" style="margin: 1.5rem 0;" hidden>
        <h3 style="margin-bottom: 0.75rem;">Select Columns to Keep (CSV Column Filter)</h3>
        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
          <button type="button" class="btn btn-small" id="select-all" style="background-color: var(--brand-dark);">Select All</button>
          <button type="button" class="btn btn-small" id="deselect-all" style="background-color: var(--muted);">Deselect All</button>
        </div>
        <div class="columns-grid" id="columns-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.6rem; margin-top: 1rem; max-height: 250px; overflow-y: auto; border: 1px solid var(--border); padding: 1rem; border-radius: 8px; background: #fff;"></div>
      </div>
      
      <button class="btn" id="run" disabled>Extract Columns</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
      <ul class="results" id="results"></ul>
    </div>

    <AdSlot format="horizontal" />

    <h2>How to Extract Columns from CSV (Step-by-Step Guide)</h2>
    <ol class="steps">
      <li><strong>Select Your Source Dataset:</strong> Drag and drop your CSV into the dropzone above, or click to browse. The parser immediately extracts header metadata and renders a 6-row sample preview.</li>
      <li><strong>Configure Column Filtering:</strong>
        <ul>
          <li><strong>Extract Specific Columns:</strong> Click <strong>Deselect All</strong>, then check only the columns you need for downstream reporting (e.g., <code>[Customer_ID, Email, Lifetime_Spend]</code>).</li>
          <li><strong>Prune Bloated Columns:</strong> Leave all checked, then uncheck bulky metadata columns like raw JSON payloads, verbose audit logs, or tracking tokens.</li>
        </ul>
      </li>
      <li><strong>Run Filtering Engine:</strong> Click <strong>Extract Columns</strong>. The background Web Worker processes your data row by row, keeping only the selected column indices.</li>
      <li><strong>Export Streamlined File:</strong> Download your lean, lightweight CSV immediately to your local device.</li>
    </ol>

    <h2>Why Spreadsheet Software Struggles with Wide Column Datasets</h2>
    <p>
      Enterprise exports from modern SaaS platforms (Shopify, Salesforce, HubSpot, Stripe) regularly output tables with 80 to 250+ columns. Managing wide tables inside traditional desktop spreadsheets introduces significant friction:
    </p>
    <ul>
      <li><strong>The Horizontal Scrolling Nightmare:</strong> Navigating through 150 columns in Excel or Google Sheets requires endless horizontal scrolling. Deleting 80 non-adjacent columns manually takes 10+ minutes and carries severe risk of accidentally deleting primary keys.</li>
      <li><strong>Severe RAM Multiplication:</strong> Spreadsheet applications allocate separate visual rendering cells for every column on every row. A file with 100,000 rows and 120 columns forces Excel to instantiate 12 million graphical cells in memory, triggering system freeze warnings.</li>
      <li><strong>Database Ingestion Failures:</strong> Uploading bloated 100-column CSVs into SQL databases (PostgreSQL, MySQL, BigQuery) requires complex schema definitions. Filtering out 90% of unused columns before import speeds up query ingestion by up to 10x.</li>
    </ul>

    <h2>Developer Automation: Command-Line &amp; Script Alternatives</h2>
    <p>
      For recurring data pipelines, developers isolate specific columns using Python or standard Unix command-line utilities:
    </p>

    <h3>1. Python &amp; Pandas (Filter by Column List)</h3>
    <pre><code>import pandas as pd

# Ingest only selected columns to conserve system memory
desired_columns = ["customer_id", "email", "total_orders"]
df = pd.read_csv("enterprise_export.csv", usecols=desired_columns)

# Export clean, lightweight file
df.to_csv("lean_customer_list.csv", index=False)
print(f"Extracted &#123;len(desired_columns)&#125; columns across &#123;len(df)&#125; rows.")</code></pre>

    <h3>2. GNU Cut (Instant Positional Column Filtering)</h3>
    <pre><code># Extract columns 1, 3, and 5 from a standard CSV
cut -d, -f1,3,5 massive_export.csv &gt; filtered_output.csv</code></pre>

    <h2>Edge-Case Troubleshooting &amp; Formatting Tips</h2>
    <p>
      When extracting columns from diverse datasets, verify these common traps:
    </p>
    <ul>
      <li><strong>Duplicate Column Names:</strong> If your export contains two columns with the exact same name (e.g., two <code>ID</code> columns), downstream SQL databases will reject the file. Rename duplicates or inspect column indices carefully.</li>
      <li><strong>Preserving Multi-line Quoted Fields:</strong> If an extracted column contains addresses or survey feedback with internal line breaks, our RFC 4180 parser ensures all line breaks remain safely enclosed within their quotes.</li>
      <li><strong>Subsequent Operations:</strong> Need to remove duplicate emails from your newly extracted customer list? Easily run your file through our <a href="/remove-duplicates-csv/">Duplicate Row Remover</a>.</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <aside class="related">
      <strong>Related tools:</strong>
      <a href="/split-csv/">Split CSV files</a> ·
      <a href="/merge-csv/">Merge CSV files</a> ·
      <a href="/remove-duplicates-csv/">Remove duplicate rows</a> ·
      <a href="/change-delimiter-csv/">Change CSV delimiter</a> ·
      <a href="/guides/">All guides</a>
    </aside>
  </div>

  <script is:inline src="/js/tool-common.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var T = window.CSVTB, file = null;
      var worker = new Worker('/workers/csv-worker.js');
      var $ = function (id) { return document.getElementById(id); };
      var runBtn = $('run'), status = $('status'), resultsEl = $('results');

      T.setupDropzone('dropzone', 'file-input', function (files) {
        file = files[0];
        $('file-name').textContent = 'Selected: ' + file.name + ' (' + T.formatBytes(file.size) + ')';
        $('file-name').hidden = false;
        T.previewCSV(file, $('preview'), 6);
        worker.postMessage({ op: 'headers', file: file });
      });

      worker.onmessage = function (e) {
        var d = e.data;
        if (d.type === 'headers') {
          var container = $('columns-container');
          container.innerHTML = d.headers.map(function (h) {
            return '<label class="checkbox"><input type="checkbox" name="columns" value="' + T.esc(h) + '" checked autocomplete="off" /> ' + T.esc(h) + '</label>';
          }).join('');
          $('options-section').hidden = false;
          runBtn.disabled = false;
        } else if (d.type === 'progress') {
          status.textContent = 'Extracting… ' + d.rows.toLocaleString() + ' rows read';
        } else if (d.type === 'file') {
          T.addResult(resultsEl, d);
        } else if (d.type === 'done') {
          status.textContent = 'Done — successfully extracted columns for ' + d.rows.toLocaleString() + ' rows.';
          runBtn.disabled = false;
        } else if (d.type === 'error') {
          status.textContent = 'Error: ' + d.message;
          runBtn.disabled = false;
        }
      };

      $('select-all').addEventListener('click', function () {
        document.querySelectorAll('input[name="columns"]').forEach(function (cb) { cb.checked = true; });
      });
      $('deselect-all').addEventListener('click', function () {
        document.querySelectorAll('input[name="columns"]').forEach(function (cb) { cb.checked = false; });
      });

      runBtn.addEventListener('click', function () {
        if (!file) return;
        var checked = Array.prototype.slice.call(document.querySelectorAll('input[name="columns"]:checked')).map(function (cb) { return cb.value; });
        if (!checked.length) {
          alert('Please select at least one column to keep.');
          return;
        }
        resultsEl.innerHTML = '';
        runBtn.disabled = true;
        status.textContent = 'Extracting…';
        worker.postMessage({
          op: 'extract-columns',
          file: file,
          options: {
            columns: checked,
            keepHeader: true
          }
        });
      });
    });
  </script>
</Base>
